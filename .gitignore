__pycache__/
*.pyc
.DS_Store

# Personal / not for cloud sync
work-spec/

# Company-internal (ZF) skills
zf-*/

# Tracked on purpose — cloud sessions clone this repo fresh, so anything the
# skills need at startup has to be committed.
#   .claude/skills/   — project skills, loaded at session start
#   skills-lock.json  — pins their upstream versions (npx skills update)
!.claude/
!skills-lock.json
