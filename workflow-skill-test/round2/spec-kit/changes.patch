+:root {
+  --bg: #ffffff;
+  --fg: #1b1b1b;
+  --muted: #626262;
+  --border: #d8d8d8;
+  --surface: #f6f6f6;
+  --accent: #0b5fff;
+  --bad: #b3261e;
+  --good: #146c43;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #16181c;
+    --fg: #e8e8e8;
+    --muted: #a0a0a0;
+    --border: #33363d;
+    --surface: #1f2229;
+    --accent: #6ea8fe;
+    --bad: #ff6b6b;
+    --good: #5dd39e;
+  }
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  padding: 1.5rem;
+  background: var(--bg);
+  color: var(--fg);
+  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+}
+
+.summary__title { font-size: 1.4rem; margin: 0 0 .5rem; }
+
+.verdict { font-weight: 600; margin: .25rem 0 1rem; }
+.verdict--pass { color: var(--good); }
+.verdict--fail { color: var(--bad); }
+
+.stats { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1rem; }
+.stat {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: .6rem .9rem;
+  min-width: 8rem;
+}
+.stat__value { font-size: 1.5rem; font-weight: 600; }
+.stat--bad .stat__value { color: var(--bad); }
+.stat__label { color: var(--muted); font-size: .8rem; }
+
+.notice {
+  border-left: 3px solid var(--accent);
+  background: var(--surface);
+  padding: .6rem .8rem;
+  margin: .5rem 0;
+  border-radius: 0 6px 6px 0;
+}
+
+.breakdowns { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1rem 0 1.5rem; }
+.breakdown { min-width: 14rem; }
+.breakdown__title { font-size: .95rem; margin: 0 0 .4rem; }
+.breakdown__list { list-style: none; margin: 0; padding: 0; }
+.breakdown__item {
+  display: flex;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: .15rem 0;
+  border-bottom: 1px solid var(--border);
+}
+.breakdown__count { font-variant-numeric: tabular-nums; color: var(--muted); }
+.breakdown__empty { color: var(--muted); margin: 0; }
+
+.controls { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .75rem; }
+.controls input, .controls select {
+  background: var(--bg);
+  color: var(--fg);
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  padding: .4rem .5rem;
+  font: inherit;
+}
+.controls__search { flex: 1 1 16rem; min-width: 10rem; }
+.controls__count { color: var(--muted); font-size: .85rem; margin-left: auto; }
+
+.table-host { overflow-x: auto; }
+
+table.violations { border-collapse: collapse; width: 100%; font-size: .92rem; }
+.violations__heading {
+  text-align: left;
+  border-bottom: 2px solid var(--border);
+  padding: .45rem .6rem;
+  cursor: pointer;
+  white-space: nowrap;
+  user-select: none;
+}
+.violations__heading.sorted-asc::after { content: " ▲"; color: var(--muted); }
+.violations__heading.sorted-desc::after { content: " ▼"; color: var(--muted); }
+.violations__heading:focus-visible { outline: 2px solid var(--accent); }
+
+tr.violation { cursor: pointer; border-bottom: 1px solid var(--border); }
+tr.violation:hover, tr.violation:focus-visible { background: var(--surface); }
+tr.violation td { padding: .4rem .6rem; vertical-align: top; }
+.violation__value {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  word-break: break-word;
+  max-width: 32rem;
+}
+.violation--open { background: var(--surface); }
+
+.badge {
+  display: inline-block;
+  padding: .1rem .45rem;
+  border-radius: 999px;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  font-size: .78rem;
+  white-space: nowrap;
+}
+
+.detail__cell { background: var(--surface); padding: .6rem 1rem !important; }
+.detail__grid {
+  display: grid;
+  grid-template-columns: max-content 1fr;
+  gap: .25rem .9rem;
+  margin: 0;
+}
+.detail__label { color: var(--muted); font-weight: 600; }
+.detail__value {
+  margin: 0;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  word-break: break-word;
+}
+
+.violations__empty td { padding: 1rem .6rem; color: var(--muted); }
