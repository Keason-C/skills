+++ b/frontend/src/types.ts
@@ -0,0 +1,51 @@
+// Mirrors specs/001-data-validation-report/contracts/json-output.md exactly.
+// If the Python side changes shape, this file must change with it.
+
+export interface Violation {
+  kind: string;
+  column: string;
+  message: string;
+  row_id: string | null;
+  value: unknown;
+  expected: string | null;
+  row?: Record<string, unknown>;
+}
+
+export interface ValidationSummary {
+  table: string;
+  rows_checked: number;
+  rows_with_violations: number;
+  total_violations: number;
+  violations_by_kind: Record<string, number>;
+  violations_by_column: Record<string, number>;
+  truncated: boolean;
+  scan_limited: boolean;
+  max_violations: number;
+  scan_limit: number | null;
+}
+
+export interface ValidationReport {
+  table: string;
+  ok: boolean;
+  summary: ValidationSummary;
+  violations: Violation[];
+}
+
+export type SortField = "row_id" | "column" | "kind" | "value";
+export type SortDirection = "asc" | "desc";
+
+export interface FilterState {
+  column: string | null;
+  kind: string | null;
+  search: string;
+  sortBy: SortField;
+  sortDirection: SortDirection;
+}
+
+export const initialFilterState = (): FilterState => ({
+  column: null,
+  kind: null,
+  search: "",
+  sortBy: "row_id",
+  sortDirection: "asc",
+});
diff --git a/frontend/test/filters.test.ts b/frontend/test/filters.test.ts
new file mode 100644
index 0000000..bd70e10
--- /dev/null
+++ b/frontend/test/filters.test.ts
@@ -0,0 +1,176 @@
+import { describe, expect, it } from "vitest";
+import {
+  applyFilters,
+  displayValue,
+  distinctColumns,
+  distinctKinds,
+  matchesSearch,
+  toggleSort,
+} from "../src/filters.js";
+import type { FilterState, Violation } from "../src/types.js";
+import { initialFilterState } from "../src/types.js";
+
+const v = (over: Partial<Violation>): Violation => ({
+  kind: "type-invalid",
+  column: "age",
+  message: "Expected integer",
+  row_id: "1",
+  value: "abc",
+  expected: "integer",
+  ...over,
+});
+
+const sample: Violation[] = [
+  v({ row_id: "2", column: "age", kind: "type-invalid", value: "abc" }),
+  v({ row_id: "1", column: "age", kind: "type-coercible", value: "30" }),
+  v({ row_id: "10", column: "status", kind: "enum", value: "banana" }),
+  v({ row_id: null, column: "email", kind: "missing-column", value: null }),
+];
+
+const state = (over: Partial<FilterState> = {}): FilterState => ({
+  ...initialFilterState(),
+  ...over,
+});
+
+describe("displayValue", () => {
+  it("renders null as NULL", () => {
+    expect(displayValue(null)).toBe("NULL");
+  });
+  it("passes strings through unchanged", () => {
+    expect(displayValue("abc")).toBe("abc");
+  });
+  it("distinguishes the empty string from NULL", () => {
+    expect(displayValue("")).toBe("");
+    expect(displayValue("")).not.toBe(displayValue(null));
+  });
+  it("JSON-encodes numbers", () => {
+    expect(displayValue(42)).toBe("42");
+  });
+});
+
+describe("column filter", () => {
+  it("keeps only the chosen column", () => {
+    const out = applyFilters(sample, state({ column: "age" }));
+    expect(out).toHaveLength(2);
+    expect(out.every((x) => x.column === "age")).toBe(true);
+  });
+  it("returns everything when unset", () => {
+    expect(applyFilters(sample, state())).toHaveLength(4);
+  });
+});
+
+describe("kind filter", () => {
+  it("separates type-coercible from type-invalid", () => {
+    // This split is the whole reason strict mode stays usable, so it gets a
+    // dedicated test.
+    const invalid = applyFilters(sample, state({ kind: "type-invalid" }));
+    const coercible = applyFilters(sample, state({ kind: "type-coercible" }));
+    expect(invalid).toHaveLength(1);
+    expect(coercible).toHaveLength(1);
+    expect(invalid[0]!.value).toBe("abc");
+    expect(coercible[0]!.value).toBe("30");
+  });
+});
+
+describe("search", () => {
+  it("matches on column name", () => {
+    expect(applyFilters(sample, state({ search: "status" }))).toHaveLength(1);
+  });
+  it("matches on value", () => {
+    expect(applyFilters(sample, state({ search: "banana" }))).toHaveLength(1);
+  });
+  it("matches on row id", () => {
+    expect(applyFilters(sample, state({ search: "10" }))).toHaveLength(1);
+  });
+  it("is case insensitive", () => {
+    expect(applyFilters(sample, state({ search: "BANANA" }))).toHaveLength(1);
+  });
+  it("ignores surrounding whitespace", () => {
+    expect(matchesSearch(sample[2]!, "  banana  ")).toBe(true);
+  });
+  it("returns everything for an empty term", () => {
+    expect(applyFilters(sample, state({ search: "   " }))).toHaveLength(4);
+  });
+});
+
+describe("combined filters", () => {
+  it("applies column and kind and search together", () => {
+    const out = applyFilters(
+      sample,
+      state({ column: "age", kind: "type-invalid", search: "abc" }),
+    );
+    expect(out).toHaveLength(1);
+  });
+  it("can produce an empty result", () => {
+    const out = applyFilters(sample, state({ column: "age", kind: "enum" }));
+    expect(out).toHaveLength(0);
+  });
+});
+
+describe("sorting", () => {
+  it("sorts row ids numerically, not lexically", () => {
+    // Lexical sort would put "10" before "2"; that is confusing on a report
+    // whose whole job is helping someone find a row.
+    const out = applyFilters(sample, state({ sortBy: "row_id" }));
+    expect(out.map((x) => x.row_id)).toEqual([null, "1", "2", "10"]);
+  });
+  it("reverses direction", () => {
+    const out = applyFilters(
+      sample,
+      state({ sortBy: "row_id", sortDirection: "desc" }),
+    );
+    expect(out.map((x) => x.row_id)).toEqual(["10", "2", "1", null]);
+  });
+  it("sorts by column", () => {
+    const out = applyFilters(sample, state({ sortBy: "column" }));
+    expect(out.map((x) => x.column)).toEqual(["age", "age", "email", "status"]);
+  });
+  it("sorts by kind", () => {
+    const out = applyFilters(sample, state({ sortBy: "kind" }));
+    expect(out[0]!.kind).toBe("enum");
+  });
+  it("sorts by the displayed value, so NULL sorts as the text 'NULL'", () => {
+    // Values are compared as displayed, not as raw JS values: "30" sorts before
+    // "NULL" before "abc" before "banana".
+    const out = applyFilters(sample, state({ sortBy: "value" }));
+    expect(out.map((x) => displayValue(x.value))).toEqual([
+      "30",
+      "NULL",
+      "abc",
+      "banana",
+    ]);
+  });
+});
+
+describe("toggleSort", () => {
+  it("reverses when the field is already active", () => {
+    const next = toggleSort(state({ sortBy: "column" }), "column");
+    expect(next.sortDirection).toBe("desc");
+  });
+  it("switches field and resets to ascending", () => {
+    const next = toggleSort(
+      state({ sortBy: "column", sortDirection: "desc" }),
+      "kind",
+    );
+    expect(next).toMatchObject({ sortBy: "kind", sortDirection: "asc" });
+  });
+  it("does not mutate the input state", () => {
+    const original = state({ sortBy: "column" });
+    toggleSort(original, "column");
+    expect(original.sortDirection).toBe("asc");
+  });
+});
+
+describe("distinct helpers", () => {
+  it("lists distinct sorted columns", () => {
+    expect(distinctColumns(sample)).toEqual(["age", "email", "status"]);
+  });
+  it("lists distinct sorted kinds", () => {
+    expect(distinctKinds(sample)).toEqual([
+      "enum",
+      "missing-column",
+      "type-coercible",
+      "type-invalid",
+    ]);
+  });
+});
