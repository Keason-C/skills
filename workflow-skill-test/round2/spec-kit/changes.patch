+def test_full_row_is_opt_in(db):
+    db["t"].insert_all([{"a": "abc", "secret": "hunter2"}])
+    without = validate_table(db, "t", schema(a={"type": "integer"})).to_dict()
+    assert "row" not in without["violations"][0]
+    assert "hunter2" not in str(without)
+
+    with_row = validate_table(
+        db, "t", schema(a={"type": "integer"}), include_full_row=True
+    ).to_dict()
+    assert with_row["violations"][0]["row"]["secret"] == "hunter2"
