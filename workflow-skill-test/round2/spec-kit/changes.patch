index 0000000..52601de
--- /dev/null
+++ b/frontend/src/filters.ts
@@ -0,0 +1,104 @@
+// Pure filtering / searching / sorting. No DOM access anywhere in this file,
+// which is what makes the report's behaviour testable without a browser.
+
+import type {
+  FilterState,
+  SortDirection,
+  SortField,
+  Violation,
+} from "./types.js";
+
+/** Render a value for display and for free-text search. */
+export function displayValue(value: unknown): string {
+  if (value === null || value === undefined) return "NULL";
+  if (typeof value === "string") return value;
+  return JSON.stringify(value);
+}
+
+/** Sort key for a violation. Table-level rows (no row_id) sort first. */
+function sortKey(violation: Violation, sortBy: SortField): string {
+  switch (sortBy) {
+    case "row_id":
+      return violation.row_id ?? "";
+    case "column":
+      return violation.column;
+    case "kind":
+      return violation.kind;
+    case "value":
+      return displayValue(violation.value);
+  }
+}
+
+/**
+ * Compare row identifiers numerically when both look numeric, so that row 10
+ * sorts after row 9 rather than after row 1.
+ */
+function compare(a: string, b: string): number {
+  const na = Number(a);
+  const nb = Number(b);
+  if (a !== "" && b !== "" && !Number.isNaN(na) && !Number.isNaN(nb)) {
+    if (na !== nb) return na < nb ? -1 : 1;
+    return 0;
+  }
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+export function matchesSearch(violation: Violation, search: string): boolean {
+  const term = search.trim().toLowerCase();
+  if (!term) return true;
+  const haystack = [
+    violation.row_id ?? "",
+    violation.column,
+    violation.kind,
+    violation.message,
+    displayValue(violation.value),
+    violation.expected ?? "",
+  ]
+    .join(" ")
+    .toLowerCase();
+  return haystack.includes(term);
+}
+
+/** Apply column filter, kind filter, free-text search, then sort. */
+export function applyFilters(
+  violations: readonly Violation[],
+  state: FilterState,
+): Violation[] {
+  const filtered = violations.filter((violation) => {
+    if (state.column !== null && violation.column !== state.column) return false;
+    if (state.kind !== null && violation.kind !== state.kind) return false;
+    return matchesSearch(violation, state.search);
+  });
+
+  const direction: SortDirection = state.sortDirection;
+  const sorted = [...filtered].sort((a, b) => {
+    const result = compare(sortKey(a, state.sortBy), sortKey(b, state.sortBy));
+    return direction === "asc" ? result : -result;
+  });
+  return sorted;
+}
+
+/** Distinct column names present in the violation list, sorted. */
+export function distinctColumns(violations: readonly Violation[]): string[] {
+  return [...new Set(violations.map((v) => v.column))].sort();
+}
+
+/** Distinct violation kinds present in the violation list, sorted. */
+export function distinctKinds(violations: readonly Violation[]): string[] {
+  return [...new Set(violations.map((v) => v.kind))].sort();
+}
+
+/**
+ * Toggle sorting: clicking the active field reverses direction, clicking a new
+ * field switches to it ascending.
+ */
+export function toggleSort(state: FilterState, field: SortField): FilterState {
+  if (state.sortBy === field) {
+    return {
+      ...state,
+      sortDirection: state.sortDirection === "asc" ? "desc" : "asc",
+    };
+  }
+  return { ...state, sortBy: field, sortDirection: "asc" };
+}
diff --git a/frontend/src/main.ts b/frontend/src/main.ts
