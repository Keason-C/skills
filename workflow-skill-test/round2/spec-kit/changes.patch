+// @vitest-environment jsdom
+import { beforeEach, describe, expect, it } from "vitest";
+import { renderReport, renderSummary, renderTable } from "../src/render.js";
+import type { ValidationReport, ValidationSummary, Violation } from "../src/types.js";
+
+const summary = (over: Partial<ValidationSummary> = {}): ValidationSummary => ({
+  table: "events",
+  rows_checked: 100,
+  rows_with_violations: 3,
+  total_violations: 4,
+  violations_by_kind: { "type-invalid": 3, enum: 1 },
+  violations_by_column: { age: 3, status: 1 },
+  truncated: false,
+  scan_limited: false,
+  max_violations: 1000,
+  scan_limit: null,
+  ...over,
+});
+
+const v = (over: Partial<Violation> = {}): Violation => ({
+  kind: "type-invalid",
+  column: "age",
+  message: "Expected integer, found text 'abc'",
+  row_id: "2",
+  value: "abc",
+  expected: "integer",
+  ...over,
+});
+
+const report = (over: Partial<ValidationReport> = {}): ValidationReport => ({
+  table: "events",
+  ok: false,
+  summary: summary(),
+  violations: [v(), v({ row_id: "3", column: "status", kind: "enum", value: "banana" })],
+  ...over,
+});
+
+let root: HTMLElement;
+beforeEach(() => {
+  document.body.innerHTML = '<div id="sqlite-utils-report"></div>';
+  root = document.getElementById("sqlite-utils-report") as HTMLElement;
+});
+
+describe("renderSummary", () => {
+  it("names the table", () => {
+    const node = renderSummary(summary(), false);
+    expect(node.querySelector(".summary__title")?.textContent).toContain("events");
+  });
+
+  it("states the pass clearly when there are no violations", () => {
+    const node = renderSummary(
+      summary({ total_violations: 0, rows_with_violations: 0 }),
+      true,
+    );
+    const verdict = node.querySelector(".verdict");
+    expect(verdict?.className).toContain("verdict--pass");
+    expect(verdict?.textContent).toContain("Passed");
+  });
+
+  it("reports scan limiting and detail truncation as two separate notices", () => {
+    // FR-025b: "we only looked at N rows" and "we only listed N problems" must
+    // never be conflated.
+    const node = renderSummary(
+      summary({
+        truncated: true,
+        scan_limited: true,
+        total_violations: 5000,
+        max_violations: 1000,
+        rows_checked: 500,
+        scan_limit: 500,
+      }),
+      false,
+    );
+    const scan = node.querySelector(".notice--scan");
+    const trunc = node.querySelector(".notice--truncated");
+    expect(scan).not.toBeNull();
+    expect(trunc).not.toBeNull();
+    expect(scan!.textContent).toContain("500");
+    expect(trunc!.textContent).toContain("1,000");
+    expect(trunc!.textContent).toContain("4,000");
+  });
+
+  it("shows neither notice when neither limit applied", () => {
+    const node = renderSummary(summary(), false);
+    expect(node.querySelector(".notice--scan")).toBeNull();
+    expect(node.querySelector(".notice--truncated")).toBeNull();
+  });
+
+  it("renders the by-kind and by-column breakdowns", () => {
+    const node = renderSummary(summary(), false);
+    const text = node.querySelector(".breakdowns")?.textContent ?? "";
+    expect(text).toContain("type-invalid");
+    expect(text).toContain("age");
+  });
+});
+
+describe("renderTable", () => {
+  it("renders one visible row per violation", () => {
+    const table = renderTable([v(), v({ row_id: "3" })]);
+    expect(table.querySelectorAll("tr.violation")).toHaveLength(2);
+  });
+
+  it("shows an em dash for table-level violations with no row id", () => {
+    const table = renderTable([v({ row_id: null, kind: "missing-column" })]);
+    expect(table.querySelector(".violation__row-id")?.textContent).toBe("—");
+  });
+
+  it("reports an empty state when nothing matches", () => {
+    const table = renderTable([]);
+    expect(table.querySelector(".violations__empty")?.textContent).toContain(
+      "No violations",
+    );
+  });
+
+  it("keeps detail rows hidden until expanded", () => {
+    const table = renderTable([v()]);
+    const detail = table.querySelector("tr.detail") as HTMLElement;
+    expect(detail.hidden).toBe(true);
+  });
+
+  it("expands a row on click to reveal expected versus actual", () => {
+    const table = renderTable([v()]);
+    document.body.appendChild(table);
+    const row = table.querySelector("tr.violation") as HTMLElement;
+    const detail = table.querySelector("tr.detail") as HTMLElement;
+
+    row.click();
+    expect(detail.hidden).toBe(false);
+    expect(row.getAttribute("aria-expanded")).toBe("true");
+    const text = detail.textContent ?? "";
+    expect(text).toContain("Expected");
+    expect(text).toContain("integer");
+    expect(text).toContain("Actual");
+    expect(text).toContain("abc");
+
+    row.click();
+    expect(detail.hidden).toBe(true);
+  });
+
+  it("expands on Enter for keyboard users", () => {
+    const table = renderTable([v()]);
+    document.body.appendChild(table);
+    const row = table.querySelector("tr.violation") as HTMLElement;
+    const detail = table.querySelector("tr.detail") as HTMLElement;
+    row.dispatchEvent(
+      new KeyboardEvent("keydown", { key: "Enter", bubbles: true }),
+    );
+    expect(detail.hidden).toBe(false);
+  });
+
+  it("includes full row fields when they are present", () => {
+    const table = renderTable([
+      v({ row: { id: 2, age: "abc", status: "active" } }),
+    ]);
+    const text = table.querySelector("tr.detail")?.textContent ?? "";
+    expect(text).toContain("row.status");
+    expect(text).toContain("active");
+  });
+
+  it("renders markup in a value as literal text, never as HTML", () => {
+    // A validation report exists to show bad data; bad data must not be able to
+    // become part of the document.
+    const payload = '<img src=x onerror="window.__pwned=1">';
+    const table = renderTable([v({ value: payload })]);
+    document.body.appendChild(table);
+    const cell = table.querySelector(".violation__value") as HTMLElement;
+    expect(cell.textContent).toBe(payload);
+    expect(cell.querySelector("img")).toBeNull();
+    expect(table.querySelectorAll("img")).toHaveLength(0);
+  });
+
+  it("renders a script tag in a value as literal text", () => {
+    const payload = "</script><script>window.__pwned=1</script>";
+    const table = renderTable([v({ value: payload })]);
+    document.body.appendChild(table);
+    expect(
+      (table.querySelector(".violation__value") as HTMLElement).textContent,
+    ).toBe(payload);
+    expect(table.querySelectorAll("script")).toHaveLength(0);
+  });
+});
+
+describe("renderReport", () => {
+  it("renders summary, controls and table together", () => {
+    renderReport(root, report());
+    expect(root.querySelector(".summary")).not.toBeNull();
+    expect(root.querySelector(".controls")).not.toBeNull();
+    expect(root.querySelectorAll("tr.violation")).toHaveLength(2);
+  });
+
+  it("populates the filter dropdowns from the data", () => {
+    renderReport(root, report());
+    const columns = Array.from(
+      root.querySelectorAll(".controls__column option"),
+    ).map((o) => (o as HTMLOptionElement).value);
+    expect(columns).toEqual(["", "age", "status"]);
+  });
+
+  it("narrows the table when a column filter is chosen", () => {
+    renderReport(root, report());
+    const select = root.querySelector(".controls__column") as HTMLSelectElement;
+    select.value = "status";
+    select.dispatchEvent(new Event("change"));
+    expect(root.querySelectorAll("tr.violation")).toHaveLength(1);
+    expect(root.querySelector(".controls__count")?.textContent).toContain(
+      "Showing 1 of 2",
+    );
+  });
+
+  it("narrows the table when searching", () => {
+    renderReport(root, report());
+    const search = root.querySelector(".controls__search") as HTMLInputElement;
+    search.value = "banana";
+    search.dispatchEvent(new Event("input"));
+    expect(root.querySelectorAll("tr.violation")).toHaveLength(1);
+  });
+
+  it("reorders when a sortable heading is clicked", () => {
+    renderReport(root, report());
+    const first = () =>
+      (root.querySelector("tr.violation .violation__column") as HTMLElement)
+        .textContent;
+    const heading = root.querySelector('th[data-sort="column"]') as HTMLElement;
+    heading.click();
+    expect(first()).toBe("age");
+    (root.querySelector('th[data-sort="column"]') as HTMLElement).click();
+    expect(first()).toBe("status");
+  });
+
+  it("renders a clean report with no violations", () => {
+    renderReport(
+      root,
+      report({
+        ok: true,
+        summary: summary({ total_violations: 0, rows_with_violations: 0 }),
+        violations: [],
+      }),
+    );
+    expect(root.querySelector(".verdict--pass")).not.toBeNull();
+    expect(root.querySelector(".violations__empty")).not.toBeNull();
+  });
+});
