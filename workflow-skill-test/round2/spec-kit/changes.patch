+import pytest
+
+import sqlite_utils
+from sqlite_utils.db import NoTable
+from sqlite_utils.validate import (
+    DEFAULT_MAX_VIOLATIONS,
+    SUPPORTED_FORMATS,
+    SchemaError,
+    ViolationKind,
+    compile_schema,
+    validate_table,
+)
+
+
+@pytest.fixture
+def db():
+    return sqlite_utils.Database(memory=True)
+
+
+def schema(**properties):
+    return {"type": "object", "properties": properties}
+
+
+# ---------------------------------------------------------------- compile_schema
+
+
+def test_compile_accepts_every_supported_keyword():
+    compiled = compile_schema(
+        {
+            "type": "object",
+            "title": "Events",
+            "description": "An event row",
+            "properties": {
+                "a": {"type": "string", "minLength": 1, "maxLength": 5},
+                "b": {"type": ["string", "null"]},
+                "c": {"type": "integer", "minimum": 0, "maximum": 10},
+                "d": {"type": "number", "exclusiveMinimum": 0, "multipleOf": 0.5},
+                "e": {"type": "string", "pattern": "^x"},
+                "f": {"type": "string", "format": "date"},
+                "g": {"enum": ["a", "b"]},
+                "h": {"const": 42},
+                "i": {"type": "number", "exclusiveMaximum": 100},
+            },
+            "required": ["a"],
+            "additionalProperties": False,
+        }
+    )
+    assert compiled.required == frozenset({"a"})
+    assert compiled.additional_properties is False
+    assert compiled.rules["b"].types == frozenset({"string", "null"})
+
+
+def test_compile_is_idempotent():
+    compiled = compile_schema(schema(a={"type": "string"}))
+    assert compile_schema(compiled) is compiled
+
+
+@pytest.mark.parametrize(
+    "keyword", ["allOf", "anyOf", "oneOf", "if", "not", "$ref", "dependentRequired"]
+)
+def test_compile_rejects_unsupported_keyword(keyword):
+    # The whole point: a constraint we cannot honour must stop the run, never be
+    # quietly skipped while we report the table as valid.
+    with pytest.raises(SchemaError) as ex:
+        compile_schema(schema(a={"type": "string", keyword: []}))
+    assert keyword in str(ex.value)
+
+
+def test_compile_rejects_unsupported_root_keyword():
+    with pytest.raises(SchemaError) as ex:
+        compile_schema({"type": "object", "patternProperties": {}})
+    assert "patternProperties" in str(ex.value)
+
+
+def test_compile_rejects_non_object_schema():
+    with pytest.raises(SchemaError):
+        compile_schema([1, 2, 3])
+    with pytest.raises(SchemaError):
+        compile_schema("nope")
+
+
+def test_compile_rejects_non_object_root_type():
+    with pytest.raises(SchemaError) as ex:
+        compile_schema({"type": "array"})
+    assert "object" in str(ex.value)
+
+
+@pytest.mark.parametrize(
+    "prop,message",
+    [
+        ({"type": "wrong"}, "Unknown type"),
+        ({"type": 5}, "type must be"),
+        ({"type": []}, "empty list"),
+        ({"minLength": "x"}, "minLength must be an integer"),
+        ({"minLength": -1}, "must not be negative"),
+        ({"minimum": "x"}, "minimum must be a number"),
+        ({"enum": []}, "non-empty list"),
+        ({"enum": "abc"}, "non-empty list"),
+        ({"pattern": 5}, "pattern must be a string"),
+        ({"pattern": "([unclosed"}, "not a valid regular expression"),
+        ({"format": "uuid"}, "Unsupported format"),
+        ({"format": 5}, "format must be a string"),
+    ],
+)
+def test_compile_rejects_malformed_keyword_values(prop, message):
+    with pytest.raises(SchemaError) as ex:
+        compile_schema(schema(a=prop))
+    assert message in str(ex.value)
+
+
+def test_compile_rejects_nested_object_keywords():
+    with pytest.raises(SchemaError) as ex:
+        compile_schema(schema(a={"properties": {"b": {"type": "string"}}}))
+    assert "only supported on the root schema" in str(ex.value)
+
+
+def test_compile_rejects_bad_required_and_additional_properties():
+    with pytest.raises(SchemaError):
+        compile_schema({"type": "object", "required": "a"})
+    with pytest.raises(SchemaError):
+        compile_schema({"type": "object", "additionalProperties": {"type": "string"}})
+
+
+# ---------------------------------------------------------------- happy paths
+
+
+def test_clean_table_passes(db):
+    db["t"].insert_all([{"a": "x"}, {"a": "y"}])
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert result.ok
+    assert result.summary.rows_checked == 2
+    assert result.summary.total_violations == 0
+    assert result.violations == []
+
+
+def test_empty_table_is_a_pass_not_an_error(db):
+    db["t"].create({"a": str})
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert result.ok
+    assert result.summary.rows_checked == 0
+    assert result.summary.total_violations == 0
+
+
+def test_missing_table_raises_notable(db):
+    with pytest.raises(NoTable):
+        validate_table(db, "nope", schema(a={"type": "string"}))
+
+
+# ---------------------------------------------------------------- type handling
+
+
+def test_type_invalid_for_unparseable_text(db):
+    db["t"].insert_all([{"a": "abc"}])
+    result = validate_table(db, "t", schema(a={"type": "integer"}))
+    assert [v.kind for v in result.violations] == [ViolationKind.TYPE_INVALID]
+    assert result.violations[0].value == "abc"
+    assert result.violations[0].expected == "integer"
+
+
+def test_type_coercible_is_a_separate_kind_under_strict(db):
+    # Iris's Q1: strict by default, but coercible and invalid must be separable
+    # so a strict run is still triageable.
+    db["t"].insert_all([{"a": "42"}])
+    result = validate_table(db, "t", schema(a={"type": "integer"}))
+    assert [v.kind for v in result.violations] == [ViolationKind.TYPE_COERCIBLE]
+
+
+def test_lenient_types_accepts_coercible_but_not_invalid(db):
+    db["t"].insert_all([{"a": "42"}, {"a": "abc"}])
+    strict = validate_table(db, "t", schema(a={"type": "integer"}))
+    lenient = validate_table(db, "t", schema(a={"type": "integer"}), lenient_types=True)
+    assert strict.summary.total_violations == 2
+    assert lenient.summary.total_violations == 1
+    assert lenient.violations[0].kind == ViolationKind.TYPE_INVALID
+
+
+def test_native_integer_column_passes_type_integer(db):
+    db["t"].insert_all([{"a": 1}, {"a": 2}])
+    assert validate_table(db, "t", schema(a={"type": "integer"})).ok
+
+
+def test_float_against_number_passes(db):
+    db["t"].insert_all([{"a": 1.5}])
+    assert validate_table(db, "t", schema(a={"type": "number"})).ok
+
+
+# ---------------------------------------------------------------- NULL semantics
+
+
+def test_null_violates_a_type_that_excludes_null(db):
+    db["t"].insert_all([{"a": None}])
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert [v.kind for v in result.violations] == [ViolationKind.TYPE_INVALID]
+    assert "null" in result.violations[0].message
+
+
+def test_null_passes_a_union_type_including_null(db):
+    db["t"].insert_all([{"a": None}])
+    assert validate_table(db, "t", schema(a={"type": ["string", "null"]})).ok
+
+
+def test_null_does_not_trigger_required(db):
+    # Q4: `required` is about the column existing, not about the value. A NULL is
+    # caught by `type`, so nullability stays something the schema author states.
+    db["t"].insert_all([{"a": None}])
+    result = validate_table(
+        db, "t", {"type": "object", "properties": {"a": {}}, "required": ["a"]}
+    )
+    assert result.ok
+    assert ViolationKind.MISSING_COLUMN.value not in result.summary.violations_by_kind
+
+
+def test_empty_string_is_a_valid_string_and_is_not_null(db):
+    db["t"].insert_all([{"a": ""}])
+    assert validate_table(db, "t", schema(a={"type": "string"})).ok
+
+
+def test_empty_string_is_not_an_integer(db):
+    db["t"].insert_all([{"a": ""}])
+    result = validate_table(db, "t", schema(a={"type": "integer"}))
+    assert [v.kind for v in result.violations] == [ViolationKind.TYPE_INVALID]
+
+
+# ---------------------------------------------------------------- table-level
+
+
+def test_missing_column_reported_once_not_once_per_row(db):
+    db["t"].insert_all([{"a": "x"} for _ in range(25)])
+    result = validate_table(
+        db,
+        "t",
+        {
+            "type": "object",
+            "properties": {"a": {"type": "string"}, "email": {"type": "string"}},
+            "required": ["email"],
+        },
+    )
+    missing = [v for v in result.violations if v.kind == ViolationKind.MISSING_COLUMN]
+    assert len(missing) == 1
+    assert missing[0].column == "email"
+    assert missing[0].row_id is None
+
+
+def test_additional_properties_unset_ignores_extra_columns(db):
+    db["t"].insert_all([{"a": "x", "extra": "y"}])
+    assert validate_table(db, "t", schema(a={"type": "string"})).ok
+
+
+def test_additional_properties_false_reports_extra_columns(db):
+    db["t"].insert_all([{"a": "x", "extra": "y"}])
+    result = validate_table(
+        db,
+        "t",
+        {
+            "type": "object",
+            "properties": {"a": {"type": "string"}},
+            "additionalProperties": False,
+        },
+    )
+    assert [v.kind for v in result.violations] == [ViolationKind.UNEXPECTED_COLUMN]
+    assert result.violations[0].column == "extra"
+
+
+# ---------------------------------------------------------------- constraints
+
+
+def test_two_rules_broken_in_one_row_are_two_violations(db):
+    db["t"].insert_all([{"a": "toolong", "b": "nope"}])
+    result = validate_table(
+        db,
+        "t",
+        schema(a={"type": "string", "maxLength": 3}, b={"enum": ["yes"]}),
+    )
+    assert result.summary.total_violations == 2
+    assert result.summary.rows_with_violations == 1
+    assert {v.column for v in result.violations} == {"a", "b"}
+
+
+@pytest.mark.parametrize(
+    "prop,value,kind",
+    [
+        ({"enum": ["a", "b"]}, "z", ViolationKind.ENUM),
+        ({"const": "fixed"}, "other", ViolationKind.CONST),
+        ({"type": "integer", "minimum": 5}, 1, ViolationKind.OUT_OF_RANGE),
+        ({"type": "integer", "maximum": 5}, 9, ViolationKind.OUT_OF_RANGE),
+        ({"type": "integer", "exclusiveMinimum": 5}, 5, ViolationKind.OUT_OF_RANGE),
+        ({"type": "integer", "exclusiveMaximum": 5}, 5, ViolationKind.OUT_OF_RANGE),
+        ({"type": "integer", "multipleOf": 3}, 7, ViolationKind.MULTIPLE_OF),
+        ({"type": "string", "minLength": 3}, "ab", ViolationKind.LENGTH),
+        ({"type": "string", "maxLength": 2}, "abc", ViolationKind.LENGTH),
+        ({"type": "string", "pattern": "^x"}, "yyy", ViolationKind.PATTERN),
+        ({"type": "string", "format": "date"}, "13/13/2020", ViolationKind.FORMAT),
+    ],
+)
+def test_each_constraint_produces_its_kind(db, prop, value, kind):
+    db["t"].insert_all([{"a": value}])
+    result = validate_table(db, "t", schema(a=prop))
+    assert [v.kind for v in result.violations] == [kind]
+
+
+@pytest.mark.parametrize(
+    "prop,value",
+    [
+        ({"enum": ["a", "b"]}, "a"),
+        ({"const": "fixed"}, "fixed"),
+        ({"type": "integer", "minimum": 5}, 5),
+        ({"type": "integer", "exclusiveMinimum": 5}, 6),
+        ({"type": "integer", "multipleOf": 3}, 9),
+        ({"type": "string", "minLength": 3}, "abc"),
+        ({"type": "string", "pattern": "^x"}, "xyz"),
+    ],
+)
+def test_satisfied_constraints_produce_nothing(db, prop, value):
+    db["t"].insert_all([{"a": value}])
+    assert validate_table(db, "t", schema(a=prop)).ok
+
+
+@pytest.mark.parametrize(
+    "fmt,good,bad",
+    [
+        ("date", "2024-01-31", "2024-13-01"),
+        ("date-time", "2024-01-31T12:00:00", "yesterday"),
+        ("time", "12:30:00", "25:00:00"),
+        ("email", "a@b.com", "not-an-email"),
+        ("uri", "https://example.com", "just text"),
+        ("ipv4", "192.168.0.1", "999.1.1.1"),
+    ],
+)
+def test_supported_formats_accept_and_reject(db, fmt, good, bad):
+    assert fmt in SUPPORTED_FORMATS
+    db["good"].insert_all([{"a": good}])
+    db["bad"].insert_all([{"a": bad}])
+    assert validate_table(db, "good", schema(a={"type": "string", "format": fmt})).ok
+    result = validate_table(db, "bad", schema(a={"type": "string", "format": fmt}))
+    assert [v.kind for v in result.violations] == [ViolationKind.FORMAT]
+
+
+def test_wrong_type_does_not_also_report_every_other_constraint(db):
+    # A single bad value should produce one clear finding, not a cascade that
+    # buries it.
