         click.echo(details)
 
 
+@cli.command()
+@click.argument(
+    "path",
+    type=click.Path(file_okay=True, dir_okay=False, allow_dash=False, exists=True),
+    required=True,
+)
+@click.argument("table")
+@click.argument(
+    "schema",
+    type=click.Path(file_okay=True, dir_okay=False, allow_dash=False, exists=True),
+    required=True,
+)
+@click.option("--json", "as_json", is_flag=True, help="Output full results as JSON")
+@click.option("--html", "html_path", type=click.Path(), help="Write HTML report here")
+@click.option(
+    "--lenient-types",
+    is_flag=True,
+    help="Accept values that can be read as the declared type",
+)
+@click.option(
+    "--max-violations",
+    type=int,
+    default=validate_module.DEFAULT_MAX_VIOLATIONS,
+    show_default=True,
+    help="Maximum number of individual violations to keep",
+)
+@click.option(
+    "--scan-limit",
+    type=int,
+    default=None,
+    help="Only check the first N rows (quick spot-check)",
+)
+@click.option(
+    "--full-row",
+    is_flag=True,
+    help="Include every column of a failing row in the report",
+)
+@load_extension_option
+def validate(
+    path,
+    table,
+    schema,
+    as_json,
+    html_path,
+    lenient_types,
+    max_violations,
+    scan_limit,
+    full_row,
+    load_extension,
+):
+    """Validate a table against a JSON Schema file
+
+    Exits 0 if the table passes, 1 if violations were found, and 2 if the
+    check could not be run at all (missing table, bad schema).
+
+    Example:
+
+    \b
+        sqlite-utils validate data.db events schema.json --html report.html
+    """
+    db = sqlite_utils.Database(path)
+    _register_db_for_cleanup(db)
+    _load_extensions(db, load_extension)
+
+    # A schema we cannot honour, or a table that is not there, is a failure of
+    # the check itself -- exit 2, never 1, so a pipeline can never mistake it
+    # for "the data is dirty".
+    try:
+        compiled = validate_module.load_schema(schema)
+        result = validate_module.validate_table(
+            db,
+            table,
+            compiled,
+            lenient_types=lenient_types,
+            max_violations=max_violations,
+            scan_limit=scan_limit,
+            include_full_row=full_row,
+        )
+    except validate_module.SchemaError as ex:
+        raise click.UsageError(str(ex))
+    except NoTable:
+        raise click.UsageError(f"Table '{table}' does not exist")
+
+    if html_path:
+        pathlib.Path(html_path).write_text(
+            validate_module.build_html_report(result), encoding="utf-8"
+        )
+
+    if as_json:
+        click.echo(json.dumps(result.to_dict(), indent=2, default=str))
+    else:
+        summary = result.summary
+        if result.ok:
+            click.echo(
+                f"{table}: OK - {summary.rows_checked} row(s) checked, no violations"
+            )
+        else:
+            click.echo(
+                f"{table}: {summary.total_violations} violation(s) in "
+                f"{summary.rows_with_violations} of {summary.rows_checked} row(s)"
+            )
+            for kind, count in sorted(
+                summary.violations_by_kind.items(), key=lambda kv: -kv[1]
+            ):
+                click.echo(f"  {kind}: {count}")
+            if summary.scan_limited:
+                click.echo(f"  (only the first {summary.rows_checked} row(s) scanned)")
+            if summary.truncated:
+                click.echo(
+                    f"  (detail truncated to {summary.max_violations} violations)"
+                )
+        if html_path:
+            click.echo(f"HTML report written to {html_path}")
+
+    if not result.ok:
+        sys.exit(1)
+
+
