+      --json                    Output full results as JSON
+      --html PATH               Write HTML report here
+      --lenient-types           Accept values that can be read as the declared type
+      --max-violations INTEGER  Maximum number of individual violations to keep
+                                [default: 1000]
+      --scan-limit INTEGER      Only check the first N rows (quick spot-check)
+      --full-row                Include every column of a failing row in the report
+      --load-extension TEXT     Path to SQLite extension, with optional :entrypoint
+      -h, --help                Show this message and exit.
+
