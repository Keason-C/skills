+import json
+import pathlib
+import re
+
+import pytest
+from click.testing import CliRunner
+
+import sqlite_utils
+from sqlite_utils import cli
+
+# Exit statuses are a contract with calling scripts:
+#   0 = passed, 1 = violations found, 2 = the check could not run.
+EXIT_OK = 0
+EXIT_VIOLATIONS = 1
+EXIT_TOOL_ERROR = 2
+
+SCHEMA = {
+    "type": "object",
+    "properties": {
+        "id": {"type": "integer"},
+        "age": {"type": "integer"},
+        "status": {"type": "string", "enum": ["active", "inactive"]},
+    },
+}
+
+
+@pytest.fixture
+def workspace(tmp_path):
+    """A database with a known mix of clean and dirty rows, plus a schema file."""
+    db_path = tmp_path / "demo.db"
+    db = sqlite_utils.Database(db_path)
+    db["events"].insert_all(
+        [
+            {"id": 1, "age": 30, "status": "active"},
+            {"id": 2, "age": "abc", "status": "active"},
+            {"id": 3, "age": 25, "status": "banana"},
+        ],
+        pk="id",
+    )
+    db["clean"].insert_all([{"id": 1, "age": 30, "status": "active"}], pk="id")
+    schema_path = tmp_path / "schema.json"
+    schema_path.write_text(json.dumps(SCHEMA))
+    return tmp_path, str(db_path), str(schema_path)
+
+
+def run(*args):
+    # Click 8.4 separates stdout and stderr on the result by default, so machine
+    # output stays parseable even when a message is emitted.
+    return CliRunner().invoke(cli.cli, ["validate", *args], catch_exceptions=False)
+
+
+# ---------------------------------------------------------------- exit statuses
+
+
+def test_clean_table_exits_zero(workspace):
+    _, db_path, schema_path = workspace
+    result = run(db_path, "clean", schema_path)
+    assert result.exit_code == EXIT_OK
+    assert "OK" in result.stdout
+
+
+def test_dirty_table_exits_one(workspace):
+    _, db_path, schema_path = workspace
+    result = run(db_path, "events", schema_path)
+    assert result.exit_code == EXIT_VIOLATIONS
+    assert "violation" in result.stdout
+
+
+def test_missing_table_exits_two_not_one(workspace):
+    # A pipeline must never confuse "the check broke" with "the data is dirty".
+    _, db_path, schema_path = workspace
+    result = run(db_path, "nosuchtable", schema_path)
+    assert result.exit_code == EXIT_TOOL_ERROR
+    assert result.exit_code != EXIT_VIOLATIONS
+    assert "nosuchtable" in result.stderr
+
+
+def test_unparseable_schema_exits_two_not_one(workspace, tmp_path):
+    _, db_path, _ = workspace
+    bad = tmp_path / "bad.json"
+    bad.write_text("this is not json {")
+    result = run(db_path, "events", str(bad))
+    assert result.exit_code == EXIT_TOOL_ERROR
+    assert result.exit_code != EXIT_VIOLATIONS
+    assert "not valid JSON" in result.stderr
+
+
+def test_unsupported_keyword_exits_two_not_one(workspace, tmp_path):
+    # Refusing beats silently validating a schema we only partly understand.
+    _, db_path, _ = workspace
+    bad = tmp_path / "unsupported.json"
+    bad.write_text(json.dumps({"type": "object", "properties": {"age": {"allOf": []}}}))
+    result = run(db_path, "events", str(bad))
+    assert result.exit_code == EXIT_TOOL_ERROR
+    assert result.exit_code != EXIT_VIOLATIONS
+    assert "allOf" in result.stderr
+
+
+def test_unsupported_format_exits_two(workspace, tmp_path):
+    _, db_path, _ = workspace
+    bad = tmp_path / "fmt.json"
+    bad.write_text(
+        json.dumps({"type": "object", "properties": {"status": {"format": "uuid"}}})
+    )
+    result = run(db_path, "events", str(bad))
+    assert result.exit_code == EXIT_TOOL_ERROR
+    assert "uuid" in result.stderr
+
+
+def test_missing_schema_file_is_rejected(workspace, tmp_path):
+    _, db_path, _ = workspace
+    result = run(db_path, "events", str(tmp_path / "nope.json"))
+    assert result.exit_code == EXIT_TOOL_ERROR
+
+
+def test_empty_table_exits_zero(workspace, tmp_path):
+    _, db_path, schema_path = workspace
+    sqlite_utils.Database(db_path)["empty"].create({"id": int, "age": int})
+    result = run(db_path, "empty", schema_path)
+    assert result.exit_code == EXIT_OK
+    assert "0 row(s) checked" in result.stdout
+
+
+# ---------------------------------------------------------------- JSON output
+
+
+def test_json_output_parses_and_matches_contract(workspace):
+    _, db_path, schema_path = workspace
+    result = run(db_path, "events", schema_path, "--json")
+    assert result.exit_code == EXIT_VIOLATIONS
+    data = json.loads(result.stdout)
+    assert data["table"] == "events"
+    assert data["ok"] is False
+    assert data["summary"]["rows_checked"] == 3
+    assert len(data["violations"]) <= data["summary"]["total_violations"]
+    kinds = {v["kind"] for v in data["violations"]}
+    assert "type-invalid" in kinds
+    assert "enum" in kinds
+
+
+def test_json_output_on_clean_table_is_still_valid_json(workspace):
+    _, db_path, schema_path = workspace
+    result = run(db_path, "clean", schema_path, "--json")
+    assert result.exit_code == EXIT_OK
+    data = json.loads(result.stdout)
+    assert data["ok"] is True
+    assert data["violations"] == []
+
+
+def test_lenient_types_flag_changes_the_verdict(workspace, tmp_path):
+    db_path = str(tmp_path / "coerce.db")
+    db = sqlite_utils.Database(db_path)
+    db["t"].insert_all([{"a": "42"}])
+    schema_path = tmp_path / "s.json"
+    schema_path.write_text(
+        json.dumps({"type": "object", "properties": {"a": {"type": "integer"}}})
+    )
+    strict = run(db_path, "t", str(schema_path), "--json")
+    assert strict.exit_code == EXIT_VIOLATIONS
+    assert json.loads(strict.stdout)["violations"][0]["kind"] == "type-coercible"
+
+    lenient = run(db_path, "t", str(schema_path), "--lenient-types")
+    assert lenient.exit_code == EXIT_OK
+
+
+def test_scan_limit_and_max_violations_are_reported_separately(workspace, tmp_path):
+    db_path = str(tmp_path / "big.db")
+    db = sqlite_utils.Database(db_path)
+    db["t"].insert_all([{"a": "bad"} for _ in range(60)])
+    schema_path = tmp_path / "s.json"
+    schema_path.write_text(
+        json.dumps({"type": "object", "properties": {"a": {"type": "integer"}}})
+    )
+    result = run(
+        db_path,
+        "t",
+        str(schema_path),
+        "--scan-limit",
+        "20",
+        "--max-violations",
+        "5",
+        "--json",
+    )
+    summary = json.loads(result.stdout)["summary"]
+    assert summary["scan_limited"] is True
+    assert summary["truncated"] is True
+    assert summary["rows_checked"] == 20
+    assert summary["total_violations"] == 20
+    assert len(json.loads(result.stdout)["violations"]) == 5
+
+
+# ---------------------------------------------------------------- HTML report
+
+
+def html_for(db_path, table, schema_path, tmp_path, *extra):
+    out = tmp_path / "report.html"
+    run(db_path, table, schema_path, "--html", str(out), *extra)
+    return out.read_text()
+
+
+def test_html_report_is_written(workspace, tmp_path):
+    _, db_path, schema_path = workspace
+    html = html_for(db_path, "events", schema_path, tmp_path)
+    assert "<html" in html
+    assert "sqlite-utils-report-data" in html
+
+
+def test_html_report_has_no_external_references(workspace, tmp_path):
+    """The report must work offline, with nothing alongside it."""
+    _, db_path, schema_path = workspace
+    html = html_for(db_path, "events", schema_path, tmp_path)
+    assert "http://" not in html
+    assert "https://" not in html
+    assert not re.search(r"<script[^>]+\bsrc\s*=", html)
+    assert not re.search(r"<link[^>]+\bhref\s*=", html)
+    assert not re.search(r"url\(\s*['\"]?//", html)
+    assert "@import" not in html
+
+
+def test_html_report_embeds_the_expected_violations(workspace, tmp_path):
+    _, db_path, schema_path = workspace
+    html = html_for(db_path, "events", schema_path, tmp_path)
+    payload = json.loads(
+        re.search(
+            r'id="sqlite-utils-report-data">(.*?)</script>', html, re.DOTALL
+        ).group(1)
+    )
+    assert payload["table"] == "events"
+    kinds = {v["kind"] for v in payload["violations"]}
+    assert {"type-invalid", "enum"} <= kinds
+    assert any(v["value"] == "abc" for v in payload["violations"])
+    assert any(v["value"] == "banana" for v in payload["violations"])
+
+
+def test_html_report_for_clean_table_states_the_pass(workspace, tmp_path):
+    _, db_path, schema_path = workspace
+    html = html_for(db_path, "clean", schema_path, tmp_path)
+    payload = json.loads(
+        re.search(
+            r'id="sqlite-utils-report-data">(.*?)</script>', html, re.DOTALL
+        ).group(1)
+    )
+    assert payload["ok"] is True
+    assert payload["violations"] == []
+
+
+def test_script_payload_in_a_value_cannot_break_out_of_the_data_tag(tmp_path):
+    """Stored data must never be able to become markup."""
+    db_path = str(tmp_path / "xss.db")
+    db = sqlite_utils.Database(db_path)
+    db["t"].insert_all([{"a": "</script><script>window.pwned=1</script>"}])
+    schema_path = tmp_path / "s.json"
+    schema_path.write_text(
+        json.dumps({"type": "object", "properties": {"a": {"type": "integer"}}})
+    )
+    html = html_for(db_path, "t", str(schema_path), tmp_path)
+
+    # Exactly two script tags: the JSON data block and the bundle. A third would
+    # mean the payload escaped its container.
+    assert len(re.findall(r"<script", html)) == 2
+    # The closing tag inside the value is escaped, so it cannot terminate the
+    # data block. The payload text still appears -- as inert JSON string data,
+    # which is the point of a report about bad values.
+    assert "\\u003c/script\\u003e" in html
+    assert "</script><script>window.pwned" not in html
+
+    payload = json.loads(
+        re.search(
+            r'id="sqlite-utils-report-data">(.*?)</script>', html, re.DOTALL
+        ).group(1)
+    )
+    assert (
+        payload["violations"][0]["value"] == "</script><script>window.pwned=1</script>"
+    )
+
+
+def test_report_shows_only_the_offending_column_by_default(tmp_path):
+    """Q5: the report leaves the team, so it stays narrow unless asked."""
+    db_path = str(tmp_path / "priv.db")
+    db = sqlite_utils.Database(db_path)
+    db["t"].insert_all([{"a": "abc", "salary": "999999"}])
+    schema_path = tmp_path / "s.json"
+    schema_path.write_text(
+        json.dumps({"type": "object", "properties": {"a": {"type": "integer"}}})
+    )
+    assert "999999" not in html_for(db_path, "t", str(schema_path), tmp_path)
+    assert "999999" in html_for(db_path, "t", str(schema_path), tmp_path, "--full-row")
+
+
+def test_report_contains_no_absolute_paths(workspace, tmp_path):
+    _, db_path, schema_path = workspace
+    html = html_for(db_path, "events", schema_path, tmp_path)
+    assert db_path not in html
+    assert str(schema_path) not in html
+    assert str(tmp_path) not in html
+
+
+def test_long_values_are_truncated_in_the_report(tmp_path):
+    db_path = str(tmp_path / "long.db")
+    db = sqlite_utils.Database(db_path)
+    db["t"].insert_all([{"a": "z" * 900}])
+    schema_path = tmp_path / "s.json"
+    schema_path.write_text(
+        json.dumps({"type": "object", "properties": {"a": {"type": "integer"}}})
+    )
+    html = html_for(db_path, "t", str(schema_path), tmp_path)
+    assert "z" * 900 not in html
+    assert "truncated" in html
+
+
+def test_short_values_are_shown_whole(tmp_path):
+    db_path = str(tmp_path / "short.db")
+    db = sqlite_utils.Database(db_path)
+    db["t"].insert_all([{"a": "shortvalue"}])
+    schema_path = tmp_path / "s.json"
+    schema_path.write_text(
+        json.dumps({"type": "object", "properties": {"a": {"type": "integer"}}})
+    )
+    assert "shortvalue" in html_for(db_path, "t", str(schema_path), tmp_path)
+
+
+def test_html_and_json_agree(workspace, tmp_path):
+    """One result object feeds both renderers, so they can never disagree."""
+    _, db_path, schema_path = workspace
+    html = html_for(db_path, "events", schema_path, tmp_path)
+    embedded = json.loads(
+        re.search(
+            r'id="sqlite-utils-report-data">(.*?)</script>', html, re.DOTALL
+        ).group(1)
+    )
+    from_json = json.loads(run(db_path, "events", schema_path, "--json").stdout)
+    assert embedded["summary"] == from_json["summary"]
+
+
+def test_static_assets_ship_with_the_package():
+    static = pathlib.Path(sqlite_utils.__file__).parent / "static"
+    for name in ("report.template.html", "report.js", "report.css"):
+        assert (static / name).exists(), f"{name} missing from package data"
