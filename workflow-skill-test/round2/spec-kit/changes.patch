--- /dev/null
+++ b/frontend/src/main.ts
@@ -0,0 +1,33 @@
+import "./styles.css";
+import { renderReport } from "./render.js";
+import type { ValidationReport } from "./types.js";
+
+/** Read the report payload embedded by the Python side. */
+export function readEmbeddedReport(doc: Document): ValidationReport | null {
+  const node = doc.getElementById("sqlite-utils-report-data");
+  if (!node || !node.textContent) return null;
+  try {
+    return JSON.parse(node.textContent) as ValidationReport;
+  } catch {
+    return null;
+  }
+}
+
+export function mount(doc: Document): void {
+  const root = doc.getElementById("sqlite-utils-report");
+  if (!root) return;
+  const report = readEmbeddedReport(doc);
+  if (!report) {
+    root.textContent = "Could not read the embedded validation report data.";
+    return;
+  }
+  renderReport(root as HTMLElement, report);
+}
+
+if (typeof document !== "undefined") {
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", () => mount(document));
+  } else {
+    mount(document);
+  }
+}
diff --git a/frontend/src/render.ts b/frontend/src/render.ts
new file mode 100644
index 0000000..413d6ed
--- /dev/null
+++ b/frontend/src/render.ts
@@ -0,0 +1,301 @@
+// Data in, DOM out.
+//
+// Every node here is built with createElement/textContent. `innerHTML` is never
+// used, so a cell value containing markup renders as literal text rather than
+// becoming part of the document.
+
+import {
+  applyFilters,
+  displayValue,
+  distinctColumns,
+  distinctKinds,
+  toggleSort,
+} from "./filters.js";
+import type {
+  FilterState,
+  SortField,
+  ValidationReport,
+  ValidationSummary,
+  Violation,
+} from "./types.js";
+import { initialFilterState } from "./types.js";
+
+function el<K extends keyof HTMLElementTagNameMap>(
+  tag: K,
+  className?: string,
+  text?: string,
+): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+function stat(label: string, value: string, tone?: string): HTMLElement {
+  const box = el("div", tone ? `stat stat--${tone}` : "stat");
+  box.appendChild(el("div", "stat__value", value));
+  box.appendChild(el("div", "stat__label", label));
+  return box;
+}
+
+export function renderSummary(summary: ValidationSummary, ok: boolean): HTMLElement {
+  const section = el("section", "summary");
+
+  const heading = el("h1", "summary__title");
+  heading.textContent = `Validation report: ${summary.table}`;
+  section.appendChild(heading);
+
+  const verdict = el("p", ok ? "verdict verdict--pass" : "verdict verdict--fail");
+  verdict.textContent = ok
+    ? `Passed — all ${summary.rows_checked.toLocaleString()} rows checked satisfy the schema.`
+    : `${summary.total_violations.toLocaleString()} violation(s) across ` +
+      `${summary.rows_with_violations.toLocaleString()} row(s).`;
+  section.appendChild(verdict);
+
+  const stats = el("div", "stats");
+  stats.appendChild(stat("Rows checked", summary.rows_checked.toLocaleString()));
+  stats.appendChild(
+    stat("Rows with problems", summary.rows_with_violations.toLocaleString()),
+  );
+  stats.appendChild(
+    stat(
+      "Total violations",
+      summary.total_violations.toLocaleString(),
+      ok ? undefined : "bad",
+    ),
+  );
+  section.appendChild(stats);
+
+  // The two limits are reported as separate statements. "We only looked at N
+  // rows" and "we only listed N problems" are different facts and must never be
+  // presented as one.
+  if (summary.scan_limited) {
+    const notice = el("p", "notice notice--scan");
+    notice.textContent =
+      `Partial scan: only the first ${summary.rows_checked.toLocaleString()} ` +
+      `row(s) were examined (scan limit ${String(summary.scan_limit)}). ` +
+      `Rows beyond that were not checked at all.`;
+    section.appendChild(notice);
+  }
+  if (summary.truncated) {
+    const omitted = summary.total_violations - summary.max_violations;
+    const notice = el("p", "notice notice--truncated");
+    notice.textContent =
+      `Detail truncated: showing ${summary.max_violations.toLocaleString()} of ` +
+      `${summary.total_violations.toLocaleString()} violations ` +
+      `(${omitted.toLocaleString()} not listed). The counts above are complete.`;
+    section.appendChild(notice);
+  }
+
+  const breakdowns = el("div", "breakdowns");
+  breakdowns.appendChild(renderBreakdown("By kind", summary.violations_by_kind));
+  breakdowns.appendChild(
+    renderBreakdown("By column", summary.violations_by_column),
+  );
+  section.appendChild(breakdowns);
+
+  return section;
+}
+
+function renderBreakdown(
+  title: string,
+  counts: Record<string, number>,
+): HTMLElement {
+  const wrap = el("div", "breakdown");
+  wrap.appendChild(el("h2", "breakdown__title", title));
+  const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
+  if (entries.length === 0) {
+    wrap.appendChild(el("p", "breakdown__empty", "None"));
+    return wrap;
+  }
+  const list = el("ul", "breakdown__list");
+  for (const [name, count] of entries) {
+    const item = el("li", "breakdown__item");
+    item.appendChild(el("span", "breakdown__name", name));
+    item.appendChild(el("span", "breakdown__count", count.toLocaleString()));
+    list.appendChild(item);
+  }
+  wrap.appendChild(list);
+  return wrap;
+}
+
+function renderDetail(violation: Violation): HTMLElement {
+  const detail = el("tr", "detail");
+  const cell = el("td", "detail__cell");
+  cell.colSpan = 4;
+
+  const grid = el("dl", "detail__grid");
+  const add = (label: string, value: string): void => {
+    grid.appendChild(el("dt", "detail__label", label));
+    grid.appendChild(el("dd", "detail__value", value));
+  };
+  add("Expected", violation.expected ?? "—");
+  add("Actual", displayValue(violation.value));
+  add("Message", violation.message);
+  if (violation.row) {
+    for (const [key, value] of Object.entries(violation.row)) {
+      add(`row.${key}`, displayValue(value));
+    }
+  }
+  cell.appendChild(grid);
+  detail.appendChild(cell);
+  return detail;
+}
+
+function renderRow(violation: Violation, index: number): HTMLElement[] {
+  const row = el("tr", "violation");
+  row.tabIndex = 0;
+  row.setAttribute("role", "button");
+  row.setAttribute("aria-expanded", "false");
+  row.dataset.index = String(index);
+
+  row.appendChild(el("td", "violation__row-id", violation.row_id ?? "—"));
+  row.appendChild(el("td", "violation__column", violation.column));
+
+  const kindCell = el("td", "violation__kind");
+  kindCell.appendChild(el("span", `badge badge--${violation.kind}`, violation.kind));
+  row.appendChild(kindCell);
+
+  row.appendChild(el("td", "violation__value", displayValue(violation.value)));
+
+  const detail = renderDetail(violation);
+  detail.hidden = true;
+
+  const toggle = (): void => {
+    detail.hidden = !detail.hidden;
+    row.setAttribute("aria-expanded", detail.hidden ? "false" : "true");
+    row.classList.toggle("violation--open", !detail.hidden);
+  };
+  row.addEventListener("click", toggle);
+  row.addEventListener("keydown", (event: KeyboardEvent) => {
+    if (event.key === "Enter" || event.key === " ") {
+      event.preventDefault();
+      toggle();
+    }
+  });
+
+  return [row, detail];
+}
+
+export function renderTable(violations: readonly Violation[]): HTMLElement {
+  const table = el("table", "violations");
+  const thead = el("thead");
+  const headRow = el("tr");
+  const headings: Array<[string, SortField]> = [
+    ["Row", "row_id"],
+    ["Column", "column"],
+    ["Kind", "kind"],
+    ["Value", "value"],
+  ];
+  for (const [label, fieldName] of headings) {
+    const th = el("th", "violations__heading", label);
+    th.dataset.sort = fieldName;
+    th.tabIndex = 0;
+    th.setAttribute("role", "button");
+    headRow.appendChild(th);
+  }
+  thead.appendChild(headRow);
+  table.appendChild(thead);
+
+  const tbody = el("tbody");
+  if (violations.length === 0) {
+    const empty = el("tr", "violations__empty");
+    const cell = el("td", undefined, "No violations match the current filters.");
+    cell.colSpan = 4;
+    empty.appendChild(cell);
+    tbody.appendChild(empty);
+  } else {
+    violations.forEach((violation, index) => {
+      for (const node of renderRow(violation, index)) tbody.appendChild(node);
+    });
+  }
+  table.appendChild(tbody);
+  return table;
+}
+
+/** Mount the whole report into `root`, wiring up the interactive controls. */
+export function renderReport(root: HTMLElement, report: ValidationReport): void {
+  let state: FilterState = initialFilterState();
+
+  root.textContent = "";
+  root.appendChild(renderSummary(report.summary, report.ok));
+
+  const controls = el("section", "controls");
+
+  const search = el("input", "controls__search");
+  search.type = "search";
+  search.placeholder = "Search violations…";
+  search.setAttribute("aria-label", "Search violations");
+
+  const columnSelect = el("select", "controls__column");
+  columnSelect.setAttribute("aria-label", "Filter by column");
+  const kindSelect = el("select", "controls__kind");
+  kindSelect.setAttribute("aria-label", "Filter by kind");
+
+  const fill = (select: HTMLSelectElement, values: string[], allLabel: string) => {
+    const all = el("option", undefined, allLabel);
+    all.value = "";
+    select.appendChild(all);
+    for (const value of values) {
+      const option = el("option", undefined, value);
+      option.value = value;
+      select.appendChild(option);
+    }
+  };
+  fill(columnSelect, distinctColumns(report.violations), "All columns");
+  fill(kindSelect, distinctKinds(report.violations), "All kinds");
+
+  controls.appendChild(search);
+  controls.appendChild(columnSelect);
+  controls.appendChild(kindSelect);
+
+  const count = el("span", "controls__count");
+  controls.appendChild(count);
+  root.appendChild(controls);
+
+  const host = el("div", "table-host");
+  root.appendChild(host);
+
+  const draw = (): void => {
+    const visible = applyFilters(report.violations, state);
+    count.textContent = `Showing ${visible.length} of ${report.violations.length}`;
+    host.textContent = "";
+    const table = renderTable(visible);
+    for (const th of Array.from(table.querySelectorAll("th[data-sort]"))) {
+      const fieldName = (th as HTMLElement).dataset.sort as SortField;
+      if (fieldName === state.sortBy) {
+        th.classList.add(
+          state.sortDirection === "asc" ? "sorted-asc" : "sorted-desc",
+        );
+      }
+      const activate = (): void => {
+        state = toggleSort(state, fieldName);
+        draw();
+      };
+      th.addEventListener("click", activate);
+      th.addEventListener("keydown", (event) => {
+        const key = (event as KeyboardEvent).key;
+        if (key === "Enter" || key === " ") {
+          event.preventDefault();
+          activate();
+        }
+      });
+    }
+    host.appendChild(table);
+  };
+
+  search.addEventListener("input", () => {
+    state = { ...state, search: search.value };
+    draw();
+  });
+  columnSelect.addEventListener("change", () => {
+    state = { ...state, column: columnSelect.value || null };
+    draw();
+  });
+  kindSelect.addEventListener("change", () => {
+    state = { ...state, kind: kindSelect.value || null };
+    draw();
+  });
+
+  draw();
+}
