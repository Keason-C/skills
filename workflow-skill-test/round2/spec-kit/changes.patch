+import { fileURLToPath } from "node:url";
+import { dirname, resolve } from "node:path";
+// vitest/config re-exports Vite's defineConfig with the `test` block typed.
+import { defineConfig } from "vitest/config";
+
+// Library mode: emit ONE self-executing bundle plus ONE stylesheet, both of which
+// sqlite_utils inlines into a single HTML file. No module loader, no code
+// splitting, no asset URLs -- the report must work from a file:// URL with no
+// network access at all (FR-014).
+const here = dirname(fileURLToPath(import.meta.url));
+
+export default defineConfig({
+  build: {
+    outDir: resolve(here, "../sqlite_utils/static"),
+    emptyOutDir: false,
+    cssCodeSplit: false,
+    // Inline every asset; a report that referenced an external file would not be
+    // self-contained.
+    assetsInlineLimit: 100_000_000,
+    lib: {
+      entry: resolve(here, "src/main.ts"),
+      name: "SqliteUtilsReport",
+      formats: ["iife"],
+      fileName: () => "report.js",
+    },
+    rollupOptions: {
+      output: {
+        assetFileNames: "report.[ext]",
+      },
+    },
+    // Vite 8 bundles with rolldown/oxc; the default minifier needs no extra
+    // package, whereas "esbuild" would now be a separate install.
+    minify: true,
+    target: "es2020",
+  },
+  test: {
+    environment: "jsdom",
+    globals: true,
+    include: ["test/**/*.test.ts"],
+  },
+});
