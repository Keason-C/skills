+
+def test_row_id_falls_back_to_rowid(db):
+    db["t"].insert_all([{"a": 1}, {"a": 2}])
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert [v.row_id for v in result.violations] == ["1", "2"]
+
+
+def test_row_id_handles_compound_primary_key(db):
+    db["t"].insert_all([{"x": "p", "y": "q", "a": 1}], pk=("x", "y"))
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert result.violations[0].row_id == "p, q"
+
+
+# ---------------------------------------------------------------- limits
+
+
+def test_max_violations_truncates_detail_but_not_totals(db):
+    db["t"].insert_all([{"a": "bad"} for _ in range(50)])
+    result = validate_table(db, "t", schema(a={"type": "integer"}), max_violations=5)
+    assert len(result.violations) == 5
+    assert result.summary.total_violations == 50
+    assert result.summary.violations_by_kind[ViolationKind.TYPE_INVALID.value] == 50
+    assert result.summary.violations_by_column["a"] == 50
+    assert result.summary.truncated is True
+    assert result.summary.scan_limited is False
+
+
+def test_violation_list_never_exceeds_total(db):
+    db["t"].insert_all([{"a": "bad"} for _ in range(20)])
+    result = validate_table(db, "t", schema(a={"type": "integer"}), max_violations=5)
+    assert len(result.violations) <= result.summary.total_violations
+
+
+def test_scan_limit_bounds_rows_checked(db):
+    db["t"].insert_all([{"a": "bad"} for _ in range(100)])
+    result = validate_table(db, "t", schema(a={"type": "integer"}), scan_limit=10)
+    assert result.summary.rows_checked == 10
+    assert result.summary.total_violations == 10
+    assert result.summary.scan_limited is True
+    assert result.summary.truncated is False
+
+
+def test_scan_limit_and_truncation_are_independent(db):
+    db["t"].insert_all([{"a": "bad"} for _ in range(100)])
+    both = validate_table(
+        db, "t", schema(a={"type": "integer"}), scan_limit=20, max_violations=5
+    )
+    assert both.summary.scan_limited is True
+    assert both.summary.truncated is True
+    assert both.summary.rows_checked == 20
+    assert both.summary.total_violations == 20
+    assert len(both.violations) == 5
+
+    neither = validate_table(db, "t", schema(a={"type": "integer"}))
+    assert neither.summary.scan_limited is False
+    assert neither.summary.truncated is False
+
+
+def test_scan_limit_larger_than_table_is_not_reported_as_limited(db):
+    db["t"].insert_all([{"a": "bad"} for _ in range(3)])
+    result = validate_table(db, "t", schema(a={"type": "integer"}), scan_limit=999)
+    assert result.summary.scan_limited is False
+
+
+def test_default_max_violations_is_applied(db):
+    db["t"].insert_all([{"a": "x"}])
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert result.summary.max_violations == DEFAULT_MAX_VIOLATIONS
+
+
+# ---------------------------------------------------------------- serialisation
+
+
+def test_to_dict_matches_the_documented_contract(db):
+    db["t"].insert_all([{"a": "abc"}])
