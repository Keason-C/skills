+    result = validate_table(
+        db, "t", schema(a={"type": "integer", "minimum": 5, "multipleOf": 2})
+    )
+    assert [v.kind for v in result.violations] == [ViolationKind.TYPE_INVALID]
+
+
+# ---------------------------------------------------------------- row identity
+
+
+def test_row_id_uses_primary_key(db):
+    db["t"].insert_all([{"id": "abc", "a": 1}], pk="id")
+    result = validate_table(db, "t", schema(a={"type": "string"}))
+    assert result.violations[0].row_id == "abc"
