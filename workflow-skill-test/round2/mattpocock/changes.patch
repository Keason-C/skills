--- /dev/null
+++ b/frontend/src/filters.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, test } from "vitest";
+
+import { DEFAULT_FILTER_STATE, formatKey, selectViolations } from "./filters";
+import { aViolation } from "./fixtures";
+
+const violations = [
+  aViolation({ key: { id: 2 }, column: "age", kind: "type", actual: "four" }),
+  aViolation({ key: { id: 10 }, column: "name", kind: "minLength", actual: "" }),
+  aViolation({ key: { id: 9 }, column: "age", kind: "minimum", actual: -3 }),
+];
+
+const state = (overrides = {}) => ({ ...DEFAULT_FILTER_STATE, ...overrides });
+
+describe("selectViolations", () => {
+  test("shows everything by default", () => {
+    expect(selectViolations(violations, state())).toHaveLength(3);
+  });
+
+  test("filters by column", () => {
+    const selected = selectViolations(violations, state({ column: "age" }));
+    expect(selected.map((v) => v.key["id"])).toEqual([2, 9]);
+  });
+
+  test("filters by violation kind", () => {
+    const selected = selectViolations(violations, state({ kind: "minLength" }));
+    expect(selected.map((v) => v.key["id"])).toEqual([10]);
+  });
+
+  test("searches across the key, column, kind and value", () => {
+    expect(
+      selectViolations(violations, state({ search: "four" })).map((v) => v.column),
+    ).toEqual(["age"]);
+    expect(selectViolations(violations, state({ search: "MINIMUM" }))).toHaveLength(
+      1,
+    );
+    expect(selectViolations(violations, state({ search: "id=10" }))).toHaveLength(1);
+  });
+
+  test("composes filters with search", () => {
+    const selected = selectViolations(
+      violations,
+      state({ column: "age", search: "four" }),
+    );
+    expect(selected).toHaveLength(1);
+  });
+
+  test("sorts numeric keys numerically, not as text", () => {
+    const selected = selectViolations(violations, state({ sort: "row" }));
+    expect(selected.map((v) => v.key["id"])).toEqual([2, 9, 10]);
+  });
+
+  test("sorts descending", () => {
+    const selected = selectViolations(
+      violations,
+      state({ sort: "row", direction: "desc" }),
+    );
+    expect(selected.map((v) => v.key["id"])).toEqual([10, 9, 2]);
+  });
+
+  test("sorts by kind, alphabetically as a reader would expect", () => {
+    // Locale collation, so "minimum" comes before "minLength" - case is not a
+    // primary difference to a person reading the list
+    const selected = selectViolations(violations, state({ sort: "kind" }));
+    expect(selected.map((v) => v.kind)).toEqual(["minimum", "minLength", "type"]);
+  });
+
+  test("leaves the input untouched", () => {
+    selectViolations(violations, state({ sort: "kind" }));
+    expect(violations.map((v) => v.key["id"])).toEqual([2, 10, 9]);
+  });
+});
+
+describe("formatKey", () => {
+  test("renders a single-column key", () => {
+    expect(formatKey({ id: 3 })).toBe("id=3");
+  });
+
+  test("renders a compound key", () => {
+    expect(formatKey({ year: 2026, slug: "a" })).toBe("year=2026, slug=a");
+  });
+
+  test("renders a rowid key", () => {
+    expect(formatKey({ rowid: 12 })).toBe("rowid=12");
+  });
+});
diff --git a/frontend/src/filters.ts b/frontend/src/filters.ts
new file mode 100644
index 0000000..60d1a2d
--- /dev/null
+++ b/frontend/src/filters.ts
@@ -0,0 +1,94 @@
+import type { Violation } from "./types";
+
+export type SortKey = "row" | "column" | "kind";
+export type SortDirection = "asc" | "desc";
+
+export interface FilterState {
+  /** "" means every column. */
+  column: string;
+  /** "" means every violation kind. */
+  kind: string;
+  search: string;
+  sort: SortKey;
+  direction: SortDirection;
+}
+
+export const DEFAULT_FILTER_STATE: FilterState = {
+  column: "",
+  kind: "",
+  search: "",
+  sort: "row",
+  direction: "asc",
+};
+
+/** A row's key rendered for display: "id=3", or "a=1, b=2" for a compound key. */
+export function formatKey(key: Record<string, unknown>): string {
+  return Object.entries(key)
+    .map(([name, value]) => `${name}=${formatValue(value)}`)
+    .join(", ");
+}
+
+export function formatValue(value: unknown): string {
+  if (value === null || value === undefined) return "null";
+  if (typeof value === "string") return value;
+  return JSON.stringify(value) ?? String(value);
+}
+
+function searchableText(violation: Violation): string {
+  return [
+    formatKey(violation.key),
+    violation.column,
+    violation.kind,
+    violation.expected,
+    formatValue(violation.actual),
+    violation.row ? formatKey(violation.row) : "",
+  ]
+    .join(" ")
+    .toLowerCase();
+}
+
+/**
+ * Compare two keys so that numeric ids sort numerically rather than as text -
+ * "10" must come after "9".
+ */
+function compareKeys(a: Record<string, unknown>, b: Record<string, unknown>): number {
+  const aValues = Object.values(a);
+  const bValues = Object.values(b);
+  for (let i = 0; i < Math.max(aValues.length, bValues.length); i++) {
+    const left = aValues[i];
+    const right = bValues[i];
+    if (left === right) continue;
+    if (typeof left === "number" && typeof right === "number") {
+      return left - right;
+    }
+    return formatValue(left).localeCompare(formatValue(right));
+  }
+  return 0;
+}
+
+/** The violations to show, after filtering, searching and sorting. */
+export function selectViolations(
+  violations: readonly Violation[],
+  state: FilterState,
+): Violation[] {
+  const needle = state.search.trim().toLowerCase();
+  const selected = violations.filter((violation) => {
+    if (state.column && violation.column !== state.column) return false;
+    if (state.kind && violation.kind !== state.kind) return false;
+    if (needle && !searchableText(violation).includes(needle)) return false;
+    return true;
+  });
+  selected.sort((a, b) => {
+    let comparison = 0;
+    if (state.sort === "row") {
+      comparison = compareKeys(a.key, b.key);
+    } else if (state.sort === "column") {
+      comparison = a.column.localeCompare(b.column);
+    } else {
+      comparison = a.kind.localeCompare(b.kind);
+    }
+    if (comparison === 0) comparison = compareKeys(a.key, b.key);
+    return state.direction === "asc" ? comparison : -comparison;
+  });
+  return selected;
+}
