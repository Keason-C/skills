+import type { ValidationReport, Violation } from "./types";
+
+/** A violation with sensible defaults, so tests only state what they care about. */
+export function aViolation(overrides: Partial<Violation> = {}): Violation {
+  return {
+    key: { id: 1 },
+    column: "age",
+    kind: "type",
+    expected: "integer",
+    actual: "four",
+    actual_type: "text",
+    row: null,
+    ...overrides,
+  };
+}
+
+export function aReport(
+  overrides: Partial<ValidationReport> = {},
+): ValidationReport {
+  const violations = overrides.violations ?? [];
+  return {
+    table: "creatures",
+    database: "data.db",
+    schema_file: "schema.json",
+    generated_at: "2026-07-31T09:30:00Z",
+    ok: violations.length === 0,
+    rows_total: 2,
+    rows_scanned: 2,
+    rows_with_violations: violations.length,
+    violation_count: violations.length,
+    violations_shown: violations.length,
+    truncated: false,
+    detail_cap: 1000,
+    scan_limit: null,
+    counts_by_column: {},
+    counts_by_kind: {},
+    mismatches: [],
+    ...overrides,
+    violations,
+  };
+}
diff --git a/frontend/src/main.ts b/frontend/src/main.ts
new file mode 100644
index 0000000..d70849b
--- /dev/null
+++ b/frontend/src/main.ts
@@ -0,0 +1,30 @@
+import { renderReport } from "./render";
+import type { ValidationReport } from "./types";
+
+export { renderReport };
+export type { ValidationReport } from "./types";
+
+const DATA_ID = "validation-report-data";
+const ROOT_ID = "validation-report";
+
+/**
+ * Read the report Python embedded in the page and render it.
+ *
+ * The data is in a `<script type="application/json">` block rather than inline
+ * JavaScript, so a value in the data can never be executed as code.
+ */
+export function mount(document: Document): void {
+  const dataElement = document.getElementById(DATA_ID);
+  const root = document.getElementById(ROOT_ID);
+  if (!dataElement || !root) return;
+  const report = JSON.parse(dataElement.textContent ?? "{}") as ValidationReport;
+  renderReport(root, report);
+}
+
+if (typeof document !== "undefined") {
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", () => mount(document));
+  } else {
+    mount(document);
+  }
+}
