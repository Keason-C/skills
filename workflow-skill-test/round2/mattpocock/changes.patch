+"""Validate the rows of a table against a row schema.
+
+A **row schema** is an ordinary JSON Schema document describing one row of a
+table: an object schema whose ``properties`` map column names to the constraints
+their values must satisfy.
+
+Only a documented set of keywords is evaluated, and anything outside it is a
+:class:`SchemaError` rather than a silent skip -- see
+``docs/adr/0001-no-jsonschema-runtime-dependency.md``.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections import Counter
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from .db import Table
+
+__all__ = [
+    "SchemaError",
+    "SchemaMismatch",
+    "ValidationResult",
+    "Violation",
+]
+
+# Violation values are truncated to this many characters for display
+MAX_VALUE_LENGTH = 200
+
+# Sentinel: this value cannot be converted to the requested JSON Schema type
+NO_COERCION = object()
+
+
+class SchemaError(ValueError):
+    """The row schema itself is unusable, so no validation was attempted."""
+
+
+@dataclass(frozen=True)
+class Violation:
+    """One row failing one constraint."""
+
+    key: dict[str, Any]
+    column: str
+    kind: str
+    expected: str
+    actual: Any
+    actual_type: str
+    row: dict[str, Any] | None = None
+
+
+@dataclass(frozen=True)
+class SchemaMismatch:
+    """The row schema names a column the table does not have."""
+
+    column: str
+    required: bool
+
+
+@dataclass(frozen=True)
+class ValidationResult:
+    """Everything one validation run produced."""
+
+    table: str
+    rows_total: int
+    rows_scanned: int
+    rows_with_violations: int
+    violation_count: int
+    violations: list[Violation]
+    counts_by_column: dict[str, int]
+    counts_by_kind: dict[str, int]
+    mismatches: list[SchemaMismatch]
+    detail_cap: int
+    scan_limit: int | None = None
+
+    @property
+    def ok(self) -> bool:
+        """True when nothing was wrong with the data or the schema/table pairing."""
+        return not self.violation_count and not self.mismatches
+
+    @property
+    def truncated(self) -> bool:
+        """True when there were more violations than the detail cap retained."""
+        return self.violation_count > len(self.violations)
+
+
+@dataclass(frozen=True)
+class ColumnSchema:
+    """The parsed constraints for a single column."""
+
+    types: tuple[str, ...] | None = None
+    enum: tuple[Any, ...] | None = None
+    minimum: float | None = None
+    maximum: float | None = None
+    min_length: int | None = None
+    max_length: int | None = None
+    pattern: str | None = None
+    pattern_re: re.Pattern[str] | None = None
+
+    @property
+    def expected_type(self) -> str:
+        return " or ".join(self.types or ())
+
+
+@dataclass(frozen=True)
+class RowSchema:
+    """A parsed, checkable row schema."""
+
+    columns: dict[str, ColumnSchema] = field(default_factory=dict)
+    required: frozenset[str] = frozenset()
+    additional_properties: bool = True
+
+
+# Keywords carrying no constraint - accepted anywhere and ignored
+ANNOTATION_KEYWORDS = frozenset(
+    {
+        "$schema",
+        "$id",
+        "$comment",
+        "title",
+        "description",
+        "default",
+        "examples",
+        "deprecated",
+        "readOnly",
+        "writeOnly",
+    }
+)
+
+DOCUMENT_KEYWORDS = frozenset(
+    {"type", "properties", "required", "additionalProperties"}
+)
+
+COLUMN_KEYWORDS = frozenset(
+    {
+        "type",
+        "enum",
+        "minimum",
+        "maximum",
+        "minLength",
+        "maxLength",
+        "pattern",
+    }
+)
+
+
+def _reject_unsupported(
+    subschema: dict[str, Any], supported: frozenset[str], where: str
+) -> None:
+    unsupported = [
+        keyword
+        for keyword in subschema
+        if keyword not in supported and keyword not in ANNOTATION_KEYWORDS
+    ]
+    if unsupported:
+        raise SchemaError(
+            "{} {} not supported by sqlite-utils validate {} - supported "
+            "keywords are {}. Nothing was validated; a schema that is only "
+            "partly understood would report clean data that is not.".format(
+                ", ".join(f'"{keyword}"' for keyword in sorted(unsupported)),
+                "is" if len(unsupported) == 1 else "are",
+                where,
+                ", ".join(f'"{keyword}"' for keyword in sorted(supported)),
+            )
+        )
+
+
+def parse_row_schema(document: Any) -> RowSchema:
+    """Turn a JSON Schema document into a checkable :class:`RowSchema`."""
+    if not isinstance(document, dict):
+        raise SchemaError("Row schema must be a JSON object")
+    _reject_unsupported(document, DOCUMENT_KEYWORDS, "at the top level of a row schema")
+    document_type = document.get("type")
+    if document_type is not None and document_type != "object":
+        raise SchemaError(
+            f"A row schema must describe an object, not {document_type!r} - "
+            "each row is an object mapping column names to values"
+        )
+    properties = document.get("properties", {})
+    if not isinstance(properties, dict):
+        raise SchemaError('"properties" must be a JSON object')
+    required = document.get("required", [])
+    if not isinstance(required, list) or not all(
+        isinstance(name, str) for name in required
+    ):
+        raise SchemaError('"required" must be a list of column names')
+    required_names = frozenset(name for name in required if isinstance(name, str))
+    additional_properties = document.get("additionalProperties", True)
+    if not isinstance(additional_properties, bool):
+        raise SchemaError(
+            '"additionalProperties" must be true or false - subschemas are not '
+            "supported by sqlite-utils validate"
+        )
+    columns = {}
+    for name, subschema in properties.items():
+        if not isinstance(subschema, dict):
+            raise SchemaError(f'Schema for column "{name}" must be a JSON object')
+        _reject_unsupported(subschema, COLUMN_KEYWORDS, f'for column "{name}"')
+        columns[name] = _parse_column_schema(subschema, name)
+    return RowSchema(
+        columns=columns,
+        required=required_names,
+        additional_properties=additional_properties,
+    )
+
+
+JSON_TYPES = frozenset(
+    {"string", "integer", "number", "boolean", "null", "object", "array"}
+)
+
+
+def _parse_column_schema(subschema: dict[str, Any], name: str) -> ColumnSchema:
+    enum = subschema.get("enum")
+    if enum is not None and (not isinstance(enum, list) or not enum):
+        raise SchemaError(f'"enum" for column "{name}" must be a non-empty list')
+    pattern = subschema.get("pattern")
+    pattern_re = None
+    if pattern is not None:
+        if not isinstance(pattern, str):
+            raise SchemaError(f'"pattern" for column "{name}" must be a string')
+        try:
+            pattern_re = re.compile(pattern)
+        except re.error as ex:
+            raise SchemaError(
+                f'"pattern" for column "{name}" is not a valid regular '
+                f"expression: {ex}"
+            ) from ex
+    return ColumnSchema(
+        types=_parse_types(subschema.get("type"), name),
+        enum=tuple(enum) if enum is not None else None,
+        minimum=_parse_number(subschema.get("minimum"), "minimum", name),
+        maximum=_parse_number(subschema.get("maximum"), "maximum", name),
+        min_length=_parse_length(subschema.get("minLength"), "minLength", name),
+        max_length=_parse_length(subschema.get("maxLength"), "maxLength", name),
+        pattern=pattern,
+        pattern_re=pattern_re,
+    )
+
+
+def _parse_number(value: Any, keyword: str, column: str) -> float | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise SchemaError(f'"{keyword}" for column "{column}" must be a number')
+    return value
+
+
+def _parse_length(value: Any, keyword: str, column: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise SchemaError(
+            f'"{keyword}" for column "{column}" must be a non-negative integer'
+        )
+    return value
+
+
+def _parse_types(value: Any, column: str) -> tuple[str, ...] | None:
+    if value is None:
+        return None
+    names = [value] if isinstance(value, str) else value
+    if not isinstance(names, list) or not all(isinstance(n, str) for n in names):
+        raise SchemaError(f'"type" for column "{column}" must be a string or a list')
+    unknown = [name for name in names if name not in JSON_TYPES]
+    if unknown:
+        raise SchemaError(
+            'Unknown JSON Schema type {} for column "{}" - expected one of {}'.format(
+                ", ".join(repr(name) for name in unknown),
+                column,
+                ", ".join(sorted(JSON_TYPES)),
+            )
+        )
+    # dict.fromkeys de-duplicates while keeping the order the author wrote
+    return tuple(dict.fromkeys(names))
+
+
+def storage_class(value: Any) -> str:
+    """The SQLite storage class of a value read back from the database."""
+    if value is None:
+        return "null"
+    if isinstance(value, int):
+        # bool is a subclass of int, and SQLite stores both as INTEGER
+        return "integer"
+    if isinstance(value, float):
+        return "real"
+    if isinstance(value, bytes):
+        return "blob"
+    return "text"
+
+
+def _matches_type(value: Any, name: str) -> bool:
+    if name == "null":
+        return value is None
+    if name == "string":
+        return isinstance(value, str)
+    if name == "integer":
+        return isinstance(value, int) and not isinstance(value, bool)
+    if name == "number":
+        return isinstance(value, (int, float)) and not isinstance(value, bool)
+    if name == "boolean":
+        # SQLite has no boolean storage class - 0 and 1 are how it stores them
+        return isinstance(value, bool) or value in (0, 1)
+    # "object" and "array" cannot be satisfied by a SQLite scalar
+    return False
+
+
+def validate_table(
+    table: "Table",
+    schema: Any,
+    *,
+    scan_limit: int | None = None,
+    detail_cap: int = 1000,
+    coerce: bool = False,
+    empty_is_null: bool = False,
+    include_rows: bool = False,
+) -> ValidationResult:
+    """Validate every row of ``table`` against ``schema``.
+
+    The schema is parsed before a single row is read, so an unusable schema
+    raises :class:`SchemaError` instead of producing a misleading clean result.
+    """
+    row_schema = parse_row_schema(schema)
+    column_names = [column.name for column in table.columns]
+    key_names = table.pks
+
+    violations: list[Violation] = []
+    counts_by_column: Counter[str] = Counter()
+    counts_by_kind: Counter[str] = Counter()
+    violation_count = 0
+    rows_with_violations = 0
+    rows_scanned = 0
+
+    for _, row in table.pks_and_rows_where(limit=scan_limit):
+        rows_scanned += 1
+        values = {name: row[name] for name in column_names}
+        row_violations = _check_row(
+            values,
+            row_schema,
+            key={name: display_value(row[name]) for name in key_names},
+            coerce=coerce,
+            empty_is_null=empty_is_null,
+            row=(
+                {name: display_value(value) for name, value in values.items()}
+                if include_rows
+                else None
+            ),
+        )
+        if row_violations:
+            rows_with_violations += 1
+        for violation in row_violations:
+            violation_count += 1
+            counts_by_column[violation.column] += 1
+            counts_by_kind[violation.kind] += 1
+            if len(violations) < detail_cap:
+                violations.append(violation)
+
+    return ValidationResult(
+        table=table.name,
+        rows_total=table.count,
+        rows_scanned=rows_scanned,
+        rows_with_violations=rows_with_violations,
+        violation_count=violation_count,
+        violations=violations,
+        counts_by_column=dict(counts_by_column),
+        counts_by_kind=dict(counts_by_kind),
+        mismatches=find_mismatches(row_schema, column_names),
+        detail_cap=detail_cap,
+        scan_limit=scan_limit,
+    )
+
+
+def display_value(value: Any) -> Any:
+    """A JSON-safe, length-bounded rendering of a value, for reports."""
+    if isinstance(value, bytes):
+        return f"<{len(value)} byte blob>"
+    if isinstance(value, str) and len(value) > MAX_VALUE_LENGTH:
+        return value[:MAX_VALUE_LENGTH] + "…"
+    return value
+
+
+def _check_row(
+    values: dict[str, Any],
+    row_schema: RowSchema,
+    *,
+    key: dict[str, Any],
+    coerce: bool,
+    empty_is_null: bool,
+    row: dict[str, Any] | None,
+) -> list[Violation]:
+    violations = []
+    for column, column_schema in row_schema.columns.items():
+        if column not in values:
+            # Absent from the table: a schema/table mismatch, reported once for
+            # the whole run rather than once per row
+            continue
+        value = values[column]
+        if empty_is_null and value == "":
+            value = None
+        for kind, expected in _check_value(value, column_schema, coerce):
+            violations.append(_violation(key, column, kind, expected, value, row))
+    if not row_schema.additional_properties:
+        for column, value in values.items():
+            if column not in row_schema.columns:
+                violations.append(
+                    _violation(
+                        key,
+                        column,
+                        "additionalProperties",
+                        "no column beyond those the schema describes",
+                        value,
+                        row,
+                    )
+                )
+    return violations
+
+
+def _violation(
+    key: dict[str, Any],
+    column: str,
+    kind: str,
+    expected: str,
+    value: Any,
+    row: dict[str, Any] | None,
+) -> Violation:
+    return Violation(
+        key=key,
+        column=column,
+        kind=kind,
+        expected=expected,
+        actual=display_value(value),
+        actual_type=storage_class(value),
+        row=row,
+    )
+
+
+def coerce_to_type(value: Any, name: str) -> Any:
+    """Convert a SQLite value to a JSON Schema type, or ``NO_COERCION``.
+
+    Only conversions that lose nothing count: the text "123" is the integer
+    123, but "one" is not, and 1.5 is not an integer.
+    """
+    if name == "string":
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            return str(value)
+        return NO_COERCION
+    if not isinstance(value, str):
+        return NO_COERCION
+    text = value.strip()
+    if name == "integer":
+        try:
+            return int(text)
+        except ValueError:
+            return NO_COERCION
+    if name == "number":
+        try:
+            return float(text)
+        except ValueError:
+            return NO_COERCION
+    if name == "boolean":
+        if text.lower() in ("true", "1"):
+            return True
+        if text.lower() in ("false", "0"):
+            return False
+    return NO_COERCION
+
+
+def _check_value(
+    value: Any, column_schema: ColumnSchema, coerce: bool = False
+) -> list[tuple[str, str]]:
+    """Return a ``(violation kind, expectation)`` pair for each failed constraint."""
+    failures = []
+    if column_schema.types is not None and not any(
+        _matches_type(value, name) for name in column_schema.types
+    ):
+        coerced = NO_COERCION
+        for name in column_schema.types:
+            coerced = coerce_to_type(value, name)
+            if coerced is not NO_COERCION:
+                break
+        if coerced is NO_COERCION:
+            failures.append(("type", column_schema.expected_type))
+        elif coerce:
+            value = coerced
+        else:
+            failures.append(("type-coercible", column_schema.expected_type))
+    if column_schema.enum is not None and not any(
+        _same_json_value(value, permitted) for permitted in column_schema.enum
+    ):
+        failures.append(
+            (
+                "enum",
+                ", ".join(json.dumps(permitted) for permitted in column_schema.enum),
+            )
+        )
+    # Per JSON Schema, a keyword only applies to values of the kind it
+    # constrains - only "type" polices types
+    if isinstance(value, (int, float)) and not isinstance(value, bool):
+        if column_schema.minimum is not None and value < column_schema.minimum:
+            failures.append(("minimum", f"at least {column_schema.minimum}"))
+        if column_schema.maximum is not None and value > column_schema.maximum:
+            failures.append(("maximum", f"at most {column_schema.maximum}"))
+    if isinstance(value, str):
+        if (
+            column_schema.min_length is not None
+            and len(value) < column_schema.min_length
+        ):
+            failures.append(
+                ("minLength", f"at least {column_schema.min_length} characters")
+            )
+        if (
+            column_schema.max_length is not None
+            and len(value) > column_schema.max_length
+        ):
+            failures.append(
+                ("maxLength", f"at most {column_schema.max_length} characters")
+            )
+        if (
+            column_schema.pattern_re is not None
+            and not column_schema.pattern_re.search(value)
+        ):
+            failures.append(("pattern", f"matching /{column_schema.pattern}/"))
+    return failures
+
+
+def _same_json_value(value: Any, permitted: Any) -> bool:
+    """JSON equality: 1 and true are different values, unlike in Python."""
+    if isinstance(value, bool) != isinstance(permitted, bool):
+        return False
+    return value == permitted
+
+
+def find_mismatches(
+    row_schema: RowSchema, column_names: list[str]
+) -> list[SchemaMismatch]:
+    """Columns the row schema names which the table does not have."""
+    known = set(column_names)
+    named = list(row_schema.columns) + [
+        name for name in sorted(row_schema.required) if name not in row_schema.columns
+    ]
+    return [
+        SchemaMismatch(column=name, required=name in row_schema.required)
+        for name in named
+        if name not in known
+    ]
