+import pytest
+
+from sqlite_utils.validation import SchemaError
+
+
+@pytest.fixture
+def people(fresh_db):
+    fresh_db["people"].insert_all(
+        [
+            {"id": 1, "name": "Cleo", "age": 5},
+            {"id": 2, "name": "Pancakes", "age": 4},
+        ],
+        pk="id",
+    )
+    return fresh_db["people"]
+
+
+PEOPLE_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "id": {"type": "integer"},
+        "name": {"type": "string"},
+        "age": {"type": "integer"},
+    },
+}
+
+
+@pytest.fixture
+def dirty(fresh_db):
+    fresh_db.executescript("""
+        create table dirty (id integer primary key, name text, age text);
+        insert into dirty (id, name, age) values (1, 'Cleo', '5');
+        insert into dirty (id, name, age) values (2, 'Pancakes', 'four');
+        insert into dirty (id, name, age) values (3, NULL, '7');
+    """)
+    return fresh_db["dirty"]
+
+
+def test_table_matching_its_row_schema_validates_clean(people):
+    result = people.validate(PEOPLE_SCHEMA)
+    assert result.ok
+    assert result.violations == []
+    assert result.violation_count == 0
+    assert result.rows_scanned == 2
+    assert result.rows_total == 2
+
+
+def test_value_of_the_wrong_type_is_reported_with_expected_and_actual(dirty):
+    result = dirty.validate({"properties": {"age": {"type": "integer"}}})
+    assert not result.ok
+    violation = next(v for v in result.violations if v.actual == "four")
+    assert violation.column == "age"
+    assert violation.kind == "type"
+    assert violation.expected == "integer"
+    assert violation.actual_type == "text"
+    assert violation.key == {"id": 2}
+
+
+def test_null_is_json_null_so_it_fails_type_rather_than_required(dirty):
+    result = dirty.validate(
+        {"properties": {"name": {"type": "string"}}, "required": ["name"]}
+    )
+    assert [(v.key, v.kind, v.actual_type) for v in result.violations] == [
+        ({"id": 3}, "type", "null")
+    ]
+
+
+def test_null_passes_when_the_schema_admits_it(dirty):
+    result = dirty.validate({"properties": {"name": {"type": ["string", "null"]}}})
+    assert result.ok
+
+
+@pytest.mark.parametrize(
+    "schema,expected_message",
+    (
+        (
+            {"properties": {"age": {"$ref": "#/$defs/age"}}},
+            '"$ref"',
+        ),
+        (
+            {"properties": {"age": {"allOf": [{"type": "integer"}]}}},
+            '"allOf"',
+        ),
+        (
+            {"properties": {"age": {"type": "string", "format": "date"}}},
+            '"format"',
+        ),
+        ({"$defs": {"age": {"type": "integer"}}}, '"$defs"'),
+        ({"properties": {"age": {"type": "date"}}}, "'date'"),
+        ({"type": "array", "properties": {}}, "object"),
+    ),
+)
+def test_schema_the_tool_cannot_evaluate_is_rejected_loudly(
+    dirty, schema, expected_message
+):
+    with pytest.raises(SchemaError) as excinfo:
+        dirty.validate(schema)
+    assert expected_message in str(excinfo.value)
+
+
+def test_schema_that_is_not_an_object_is_rejected(dirty):
+    with pytest.raises(SchemaError):
+        dirty.validate(["not", "a", "schema"])
+
+
+def test_annotation_keywords_are_accepted_and_ignored(dirty):
+    result = dirty.validate(
+        {
+            "$schema": "https://json-schema.org/draft/2020-12/schema",
+            "title": "A row of the dirty table",
+            "description": "Ignored",
+            "properties": {
+                "age": {"type": "string", "title": "Age", "examples": ["5"]}
+            },
+        }
+    )
+    assert result.ok
+
+
+def test_rows_of_a_table_without_a_primary_key_are_identified_by_rowid(fresh_db):
+    # An untyped column has no affinity, so SQLite stores 12 as an integer
+    # rather than converting it to text
+    fresh_db.executescript("""
+        create table notes (body);
+        insert into notes (body) values ('fine');
+        insert into notes (body) values (12);
+    """)
+    result = fresh_db["notes"].validate({"properties": {"body": {"type": "string"}}})
+    assert [v.key for v in result.violations] == [{"rowid": 2}]
+
+
+def test_empty_table_validates_clean(fresh_db):
+    fresh_db.executescript("create table empty (id integer primary key, name text);")
+    result = fresh_db["empty"].validate({"properties": {"name": {"type": "string"}}})
+    assert result.ok
+    assert result.rows_scanned == 0
+    assert result.rows_total == 0
+
+
+def test_a_blob_satisfies_no_json_schema_type(fresh_db):
+    fresh_db.executescript("""
+        create table files (id integer primary key, body blob);
+        insert into files (id, body) values (1, x'6e6f7065');
+    """)
+    result = fresh_db["files"].validate({"properties": {"body": {"type": "string"}}})
+    assert [(v.kind, v.actual_type, v.actual) for v in result.violations] == [
+        ("type", "blob", "<4 byte blob>")
+    ]
+
+
+def test_sqlite_integers_satisfy_boolean_because_sqlite_has_no_boolean(fresh_db):
+    fresh_db.executescript("""
+        create table flags (id integer primary key, on_off integer);
+        insert into flags (id, on_off) values (1, 1);
+        insert into flags (id, on_off) values (2, 0);
+        insert into flags (id, on_off) values (3, 7);
+    """)
+    result = fresh_db["flags"].validate({"properties": {"on_off": {"type": "boolean"}}})
+    assert [v.key for v in result.violations] == [{"id": 3}]
+
+
+@pytest.fixture
+def measurements(fresh_db):
+    fresh_db.executescript("""
+        create table measurements (id integer primary key, grade text, reading real);
+        insert into measurements values (1, 'A', 0.5);
+        insert into measurements values (2, 'Z', 9.5);
+        insert into measurements values (3, 'AAAA', -1.0);
+    """)
+    return fresh_db["measurements"]
+
+
+def test_enum_violation_names_the_permitted_values(measurements):
+    result = measurements.validate(
+        {"properties": {"grade": {"enum": ["A", "B", "AAAA"]}}}
+    )
+    assert [(v.key, v.kind, v.actual) for v in result.violations] == [
+        ({"id": 2}, "enum", "Z")
+    ]
+    assert result.violations[0].expected == '"A", "B", "AAAA"'
+
+
+def test_minimum_and_maximum_apply_to_numbers(measurements):
+    result = measurements.validate(
+        {"properties": {"reading": {"minimum": 0, "maximum": 1}}}
+    )
+    assert [(v.key, v.kind) for v in result.violations] == [
+        ({"id": 2}, "maximum"),
+        ({"id": 3}, "minimum"),
+    ]
+
+
+def test_length_and_pattern_apply_to_strings(measurements):
+    result = measurements.validate(
+        {"properties": {"grade": {"minLength": 1, "maxLength": 2, "pattern": "^[AB]"}}}
+    )
+    assert sorted((v.key["id"], v.kind) for v in result.violations) == [
+        (2, "pattern"),
+        (3, "maxLength"),
+    ]
+
+
+def test_pattern_is_an_unanchored_search(measurements):
+    result = measurements.validate({"properties": {"grade": {"pattern": "A"}}})
+    assert [v.key for v in result.violations] == [{"id": 2}]
+
+
+def test_numeric_keywords_ignore_values_of_other_types(measurements):
+    # "A" is not a number, so minimum/maximum have nothing to say about it -
+    # only "type" polices types
+    result = measurements.validate({"properties": {"grade": {"minimum": 0}}})
+    assert result.ok
+
+
+def test_columns_the_schema_never_mentions_are_ignored_by_default(measurements):
+    result = measurements.validate({"properties": {"grade": {"type": "string"}}})
+    assert result.ok
+
+
+def test_additional_properties_false_reports_unexpected_columns(measurements):
+    result = measurements.validate(
+        {
+            "properties": {"id": {"type": "integer"}, "grade": {"type": "string"}},
+            "additionalProperties": False,
+        }
+    )
+    assert {(v.column, v.kind) for v in result.violations} == {
+        ("reading", "additionalProperties")
+    }
+    assert result.violation_count == 3
+
+
+def test_schema_naming_a_column_the_table_lacks_is_a_mismatch(measurements):
+    result = measurements.validate(
+        {
+            "properties": {"grade": {"type": "string"}, "hieght": {"type": "integer"}},
+            "required": ["grade", "wieght"],
+        }
+    )
+    assert not result.ok
+    assert sorted((m.column, m.required) for m in result.mismatches) == [
+        ("hieght", False),
+        ("wieght", True),
+    ]
+    assert result.violation_count == 0
+
+
+def test_wrong_type_that_would_convert_cleanly_is_its_own_kind(dirty):
+    result = dirty.validate({"properties": {"age": {"type": "integer"}}})
+    assert sorted((v.key["id"], v.kind, v.actual) for v in result.violations) == [
+        (1, "type-coercible", "5"),
+        (2, "type", "four"),
+        (3, "type-coercible", "7"),
+    ]
+    assert result.counts_by_kind == {"type-coercible": 2, "type": 1}
+    assert result.counts_by_column == {"age": 3}
+
+
+def test_coercion_accepts_convertible_values(dirty):
+    result = dirty.validate({"properties": {"age": {"type": "integer"}}}, coerce=True)
+    assert [(v.key["id"], v.kind) for v in result.violations] == [(2, "type")]
+
+
+def test_coercion_checks_later_constraints_against_the_converted_value(dirty):
+    result = dirty.validate(
+        {"properties": {"age": {"type": "integer", "minimum": 6}}}, coerce=True
+    )
+    assert sorted((v.key["id"], v.kind) for v in result.violations) == [
+        (1, "minimum"),
+        (2, "type"),
+    ]
+
+
+def test_empty_string_is_an_ordinary_string_by_default(fresh_db):
+    fresh_db.executescript("""
+        create table blanks (id integer primary key, note text);
+        insert into blanks values (1, '');
+    """)
+    assert fresh_db["blanks"].validate({"properties": {"note": {"type": "string"}}}).ok
+
+
+def test_empty_string_can_be_treated_as_null(fresh_db):
+    fresh_db.executescript("""
+        create table blanks (id integer primary key, note text);
+        insert into blanks values (1, '');
+    """)
+    table = fresh_db["blanks"]
+    schema = {"properties": {"note": {"type": "string"}}}
+    result = table.validate(schema, empty_is_null=True)
+    assert [(v.kind, v.actual_type) for v in result.violations] == [("type", "null")]
+    assert table.validate(
+        {"properties": {"note": {"type": ["string", "null"]}}}, empty_is_null=True
+    ).ok
+
+
+@pytest.fixture
+def many_bad_rows(fresh_db):
+    fresh_db["numbers"].insert_all(
+        ({"id": i, "value": "bad"} for i in range(1, 51)), pk="id"
+    )
+    return fresh_db["numbers"]
+
+
+def test_detail_cap_bounds_the_list_without_distorting_the_counts(many_bad_rows):
+    result = many_bad_rows.validate(
+        {"properties": {"value": {"type": "integer"}}}, detail_cap=10
+    )
+    assert result.violation_count == 50
+    assert result.rows_with_violations == 50
+    assert result.rows_scanned == 50
+    assert len(result.violations) == 10
+    assert result.truncated
+    assert result.counts_by_column == {"value": 50}
+
+
+def test_scan_limit_reads_only_the_head_of_the_table(many_bad_rows):
+    result = many_bad_rows.validate(
+        {"properties": {"value": {"type": "integer"}}}, scan_limit=5
+    )
+    assert result.rows_scanned == 5
+    assert result.rows_total == 50
+    assert result.violation_count == 5
+    assert result.scan_limit == 5
+
+
+def test_whole_rows_are_included_only_on_request(dirty):
+    schema = {"properties": {"age": {"type": "integer"}}}
+    assert all(v.row is None for v in dirty.validate(schema).violations)
+    with_rows = dirty.validate(schema, include_rows=True).violations
+    assert with_rows[0].row == {"id": 1, "name": "Cleo", "age": "5"}
+
+
+def test_long_values_are_truncated_for_display(fresh_db):
+    fresh_db["essays"].insert({"id": 1, "body": "x" * 500}, pk="id")
+    result = fresh_db["essays"].validate({"properties": {"body": {"type": "integer"}}})
+    assert result.violations[0].actual == "x" * 200 + "…"
+
+
+def test_every_keyword_product_signed_off_on_actually_works(fresh_db):
+    # Iris locked this list as an acceptance condition on #4821: all of these
+    # must work, and anything outside the supported set must fail loudly
+    fresh_db.executescript("""
+        create table locked (
+            id integer primary key, name text, grade text, score real, extra text
+        );
+        insert into locked values (1, 'Cleo', 'A', 0.5, 'ignored');
+        insert into locked values (2, '', 'Z', 99.0, 'ignored');
+    """)
+    result = fresh_db["locked"].validate(
+        {
+            "type": "object",
+            "properties": {
+                "id": {"type": "integer"},
+                "name": {"type": ["string", "null"], "minLength": 1, "maxLength": 8},
+                "grade": {"enum": ["A", "B"], "pattern": "^[AB]$"},
+                "score": {"type": "number", "minimum": 0, "maximum": 1},
+            },
+            "required": ["id", "name"],
+            "additionalProperties": False,
+        }
+    )
+    assert sorted({v.kind for v in result.violations}) == [
+        "additionalProperties",
+        "enum",
+        "maximum",
+        "minLength",
+        "pattern",
+    ]
+    assert result.counts_by_kind["additionalProperties"] == 2
