+++ b/frontend/src/types.ts
@@ -0,0 +1,40 @@
+/** The shape of the JSON report produced by `sqlite-utils validate`. */
+
+export interface Violation {
+  /** Primary key (or rowid) values identifying the row. */
+  key: Record<string, unknown>;
+  column: string;
+  /** The JSON Schema keyword that failed, or "type-coercible". */
+  kind: string;
+  expected: string;
+  actual: unknown;
+  /** SQLite storage class of the actual value. */
+  actual_type: string;
+  /** The whole row, when the run asked for it. */
+  row: Record<string, unknown> | null;
+}
+
+export interface SchemaMismatch {
+  column: string;
+  required: boolean;
+}
+
+export interface ValidationReport {
+  table: string;
+  database: string;
+  schema_file: string;
+  generated_at: string;
+  ok: boolean;
+  rows_total: number;
+  rows_scanned: number;
+  rows_with_violations: number;
+  violation_count: number;
+  violations_shown: number;
+  truncated: boolean;
+  detail_cap: number;
+  scan_limit: number | null;
+  counts_by_column: Record<string, number>;
+  counts_by_kind: Record<string, number>;
+  mismatches: SchemaMismatch[];
+  violations: Violation[];
+}
