new file mode 100644
index 0000000..1b11ba8
--- /dev/null
+++ b/sqlite_utils/report.py
@@ -0,0 +1,123 @@
+"""Render a :class:`~sqlite_utils.validation.ValidationResult` as a report.
+
+Two reports: the **JSON report**, for pipelines, and the **HTML report**, a
+single self-contained file that can be emailed to somebody who will open it
+offline.
+
+This module knows nothing about databases - it takes a validation result and
+returns text. The HTML report's behaviour lives in TypeScript under
+``frontend/``; Python only packages the built bundle and the data together, per
+``docs/adr/0003-html-report-built-with-typescript-bundle-committed.md``.
+"""
+
+from __future__ import annotations
+
+import datetime
+import json
+import pathlib
+from dataclasses import asdict
+from typing import Any
+
+from .validation import ValidationResult
+
+__all__ = ["report_dict", "render_json", "render_html"]
+
+STATIC_DIR = pathlib.Path(__file__).parent / "static"
+BUNDLE_PATH = STATIC_DIR / "validation-report.js"
+
+
+def report_dict(
+    result: ValidationResult,
+    *,
+    database: str = "",
+    schema_file: str = "",
+    generated_at: str | None = None,
+) -> dict[str, Any]:
+    """The JSON-serializable form of a validation result.
+
+    ``database`` and ``schema_file`` should be bare filenames - reports get
+    forwarded, and an absolute path leaks the layout of the machine that made it.
+    """
+    return {
+        "table": result.table,
+        "database": database,
+        "schema_file": schema_file,
+        "generated_at": generated_at or _now(),
+        "ok": result.ok,
+        "rows_total": result.rows_total,
+        "rows_scanned": result.rows_scanned,
+        "rows_with_violations": result.rows_with_violations,
+        "violation_count": result.violation_count,
+        "violations_shown": len(result.violations),
+        "truncated": result.truncated,
+        "detail_cap": result.detail_cap,
+        "scan_limit": result.scan_limit,
+        "counts_by_column": result.counts_by_column,
+        "counts_by_kind": result.counts_by_kind,
+        "mismatches": [asdict(mismatch) for mismatch in result.mismatches],
+        "violations": [asdict(violation) for violation in result.violations],
+    }
+
+
+def _now() -> str:
+    return (
+        datetime.datetime.now(datetime.timezone.utc)
+        .replace(microsecond=0)
+        .isoformat()
+        .replace("+00:00", "Z")
+    )
+
+
+def render_json(result: ValidationResult, **kwargs: Any) -> str:
+    """The validation result as indented JSON."""
+    return json.dumps(report_dict(result, **kwargs), indent=2, default=str)
+
+
+def render_html(result: ValidationResult, **kwargs: Any) -> str:
+    """The validation result as one self-contained HTML file.
+
+    Everything is inlined: no URL, stylesheet, font or script is fetched, so the
+    file works from ``file://`` on a machine with no network.
+    """
+    payload = report_dict(result, **kwargs)
+    title = "Data validation: {}".format(payload["table"])
+    return HTML_TEMPLATE.format(
+        title=_escape(title),
+        data=_embed_json(payload),
+        bundle=BUNDLE_PATH.read_text("utf-8"),
+    )
+
+
+def _escape(text: str) -> str:
+    return (
+        text.replace("&", "&amp;")
+        .replace("<", "&lt;")
+        .replace(">", "&gt;")
+        .replace('"', "&quot;")
+    )
+
+
+def _embed_json(payload: dict[str, Any]) -> str:
+    """JSON safe to drop inside a <script> element.
+
+    Outside of string literals JSON contains no ``<``, so escaping every ``<``
+    as ``\\u003c`` cannot change the parsed value - but it does mean a data
+    value containing ``</script>`` can never end the element early.
+    """
+    return json.dumps(payload, default=str).replace("<", "\\u003c")
+
+
+HTML_TEMPLATE = """<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{title}</title>
+</head>
+<body>
+<div id="validation-report"></div>
+<script type="application/json" id="validation-report-data">{data}</script>
+<script>{bundle}</script>
+</body>
+</html>
+"""
