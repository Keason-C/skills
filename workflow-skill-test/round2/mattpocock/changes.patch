@@ -0,0 +1,276 @@
+import { beforeEach, describe, expect, test } from "vitest";
+
+import { aReport, aViolation } from "./fixtures";
+import { renderReport } from "./render";
+import type { ValidationReport } from "./types";
+
+let root: HTMLElement;
+
+beforeEach(() => {
+  document.body.innerHTML = "";
+  root = document.createElement("div");
+  document.body.append(root);
+});
+
+function show(report: ValidationReport): void {
+  renderReport(root, report);
+}
+
+function rowTexts(): string[] {
+  return [...root.querySelectorAll("tbody tr.violation")].map((row) =>
+    (row.textContent ?? "").replace(/\s+/g, " ").trim(),
+  );
+}
+
+function rowKeys(): string[] {
+  return [...root.querySelectorAll("tbody tr.violation td:first-child")].map(
+    (cell) => (cell.textContent ?? "").trim(),
+  );
+}
+
+function control<T extends HTMLElement>(selector: string): T {
+  const element = root.querySelector<T>(selector);
+  if (!element) throw new Error(`No ${selector} in the report`);
+  return element;
+}
+
+function setSelect(selector: string, value: string): void {
+  const select = control<HTMLSelectElement>(selector);
+  select.value = value;
+  select.dispatchEvent(new Event("change", { bubbles: true }));
+}
+
+const threeViolations = [
+  aViolation({ key: { id: 2 }, column: "age", kind: "type", actual: "four" }),
+  aViolation({
+    key: { id: 10 },
+    column: "name",
+    kind: "minLength",
+    expected: "at least 1 characters",
+    actual: "",
+  }),
+  aViolation({ key: { id: 9 }, column: "age", kind: "minimum", actual: -3 }),
+];
+
+describe("the header", () => {
+  test("names the table, the database and the schema file", () => {
+    show(aReport());
+    const header = control("header").textContent ?? "";
+    expect(header).toContain("creatures");
+    expect(header).toContain("data.db");
+    expect(header).toContain("schema.json");
+  });
+
+  test("shows when the report was generated", () => {
+    show(aReport());
+    expect(control("header").textContent).toContain("2026-07-31T09:30:00Z");
+  });
+
+  test("shows the row and violation totals", () => {
+    show(
+      aReport({
+        violations: threeViolations,
+        rows_total: 500,
+        rows_scanned: 500,
+        rows_with_violations: 3,
+        violation_count: 3,
+        violations_shown: 3,
+        counts_by_column: { age: 2, name: 1 },
+        counts_by_kind: { type: 1, minLength: 1, minimum: 1 },
+      }),
+    );
+    const summary = control(".summary").textContent ?? "";
+    expect(summary).toContain("500");
+    expect(summary).toContain("3");
+  });
+
+  test("breaks the counts down by column and by kind", () => {
+    show(
+      aReport({
+        violations: threeViolations,
+        counts_by_column: { age: 2, name: 1 },
+        counts_by_kind: { type: 1, minLength: 1, minimum: 1 },
+      }),
+    );
+    const byColumn = control(".counts-by-column").textContent ?? "";
+    expect(byColumn).toContain("age");
+    expect(byColumn).toContain("2");
+    expect(control(".counts-by-kind").textContent).toContain("minLength");
+  });
+});
+
+describe("the clean state", () => {
+  test("says so rather than showing an empty table", () => {
+    show(aReport());
+    expect(root.textContent).toContain("No violations");
+    expect(root.querySelector("tbody")).toBeNull();
+  });
+});
+
+describe("the capped notice", () => {
+  test("appears when violations were capped, saying how many of how many", () => {
+    show(
+      aReport({
+        violations: threeViolations,
+        violation_count: 48213,
+        violations_shown: 3,
+        truncated: true,
+      }),
+    );
+    const notice = control(".capped").textContent ?? "";
+    expect(notice).toContain("3");
+    expect(notice).toContain("48,213");
+  });
+
+  test("is absent when nothing was capped", () => {
+    show(aReport({ violations: threeViolations }));
+    expect(root.querySelector(".capped")).toBeNull();
+  });
+});
+
+describe("schema mismatches", () => {
+  test("are called out separately from violations", () => {
+    show(
+      aReport({
+        mismatches: [{ column: "nmae", required: true }],
+        ok: false,
+      }),
+    );
+    expect(control(".mismatches").textContent).toContain("nmae");
+  });
+
+  test("are absent when the schema matched the table", () => {
+    show(aReport({ violations: threeViolations }));
+    expect(root.querySelector(".mismatches")).toBeNull();
+  });
+});
+
+describe("the violations table", () => {
+  test("lists every violation", () => {
+    show(aReport({ violations: threeViolations }));
+    expect(rowTexts()).toHaveLength(3);
+    expect(rowTexts()[0]).toContain("id=2");
+  });
+
+  test("filters by column", () => {
+    show(aReport({ violations: threeViolations }));
+    setSelect("select.filter-column", "name");
+    expect(rowTexts()).toHaveLength(1);
+    expect(rowTexts()[0]).toContain("id=10");
+  });
+
+  test("filters by violation kind", () => {
+    show(aReport({ violations: threeViolations }));
+    setSelect("select.filter-kind", "minimum");
+    expect(rowTexts()).toHaveLength(1);
+    expect(rowTexts()[0]).toContain("id=9");
+  });
+
+  test("offers only the columns and kinds that actually occur", () => {
+    show(aReport({ violations: threeViolations }));
+    const options = (selector: string) =>
+      [...control<HTMLSelectElement>(selector).options].map((o) => o.value);
+    expect(options("select.filter-column")).toEqual(["", "age", "name"]);
+    expect(options("select.filter-kind")).toEqual([
+      "",
+      "minimum",
+      "minLength",
+      "type",
+    ]);
+  });
+
+  test("searches", () => {
+    show(aReport({ violations: threeViolations }));
+    const search = control<HTMLInputElement>("input.search");
+    search.value = "four";
+    search.dispatchEvent(new Event("input", { bubbles: true }));
+    expect(rowTexts()).toHaveLength(1);
+  });
+
+  test("sorts", () => {
+    show(aReport({ violations: threeViolations }));
+    setSelect("select.sort", "kind");
+    expect(rowKeys()).toEqual(["id=9", "id=10", "id=2"]);
+  });
+
+  test("says when a filter matches nothing", () => {
+    show(aReport({ violations: threeViolations }));
+    const search = control<HTMLInputElement>("input.search");
+    search.value = "no such thing";
+    search.dispatchEvent(new Event("input", { bubbles: true }));
+    expect(rowTexts()).toHaveLength(0);
+    expect(root.textContent).toContain("No violations match");
+  });
+});
+
+describe("violation detail", () => {
+  test("is hidden until a violation is expanded", () => {
+    show(aReport({ violations: threeViolations }));
+    expect(root.querySelector("tr.detail")).toBeNull();
+  });
+
+  test("shows expected against actual when expanded", () => {
+    show(aReport({ violations: threeViolations }));
+    control<HTMLElement>("tbody tr.violation").click();
+    const detail = control("tr.detail").textContent ?? "";
+    expect(detail).toContain("Expected");
+    expect(detail).toContain("integer");
+    expect(detail).toContain("Actual");
+    expect(detail).toContain("four");
+    expect(detail).toContain("text");
+  });
+
+  test("shows the whole row when the report carries one", () => {
+    show(
+      aReport({
+        violations: [aViolation({ row: { id: 2, name: "Pancakes", age: "four" } })],
+      }),
+    );
+    control<HTMLElement>("tbody tr.violation").click();
+    expect(control("tr.detail").textContent).toContain("Pancakes");
+  });
+
+  test("collapses again when clicked twice", () => {
+    show(aReport({ violations: threeViolations }));
+    const row = control<HTMLElement>("tbody tr.violation");
+    row.click();
+    row.click();
+    expect(root.querySelector("tr.detail")).toBeNull();
+  });
+});
+
+describe("safety", () => {
+  test("renders hostile values as text, never as markup", () => {
+    show(
+      aReport({
+        violations: [
+          aViolation({ actual: "<img src=x onerror=alert(1)>", column: "bio" }),
+        ],
+      }),
+    );
+    expect(root.querySelector("img")).toBeNull();
+    expect(root.textContent).toContain("<img src=x onerror=alert(1)>");
+  });
+});
+
+describe("mounting into the page Python generates", () => {
+  test("reads the report out of the embedded JSON block", async () => {
+    const { mount } = await import("./main");
+    document.body.innerHTML = "";
+    const target = document.createElement("div");
+    target.id = "validation-report";
+    const data = document.createElement("script");
+    data.type = "application/json";
+    data.id = "validation-report-data";
+    data.textContent = JSON.stringify(aReport({ violations: threeViolations }));
+    document.body.append(target, data);
+    mount(document);
+    expect(target.querySelectorAll("tbody tr.violation")).toHaveLength(3);
+  });
+
+  test("does nothing when the page has no report in it", async () => {
+    const { mount } = await import("./main");
+    document.body.innerHTML = "";
+    expect(() => mount(document)).not.toThrow();
+  });
+});
diff --git a/frontend/src/render.ts b/frontend/src/render.ts
new file mode 100644
index 0000000..17ff5ae
--- /dev/null
+++ b/frontend/src/render.ts
@@ -0,0 +1,325 @@
+import styles from "./report.css?raw";
+import {
+  DEFAULT_FILTER_STATE,
+  formatKey,
+  formatValue,
+  selectViolations,
+  type FilterState,
+  type SortKey,
+} from "./filters";
+import type { ValidationReport, Violation } from "./types";
+
+const STYLE_ID = "sqlite-utils-validation-report-styles";
+
+/**
+ * Render a validation report into `root`. Data in, DOM out - everything the
+ * page can do is reachable from here, so it is all testable through this one
+ * function.
+ */
+export function renderReport(root: HTMLElement, report: ValidationReport): void {
+  injectStyles(root.ownerDocument);
+  root.textContent = "";
+  root.classList.add("sqlite-utils-validation-report");
+  root.append(header(report));
+  if (report.mismatches.length) root.append(mismatches(report));
+  if (report.truncated) root.append(cappedNotice(report));
+  if (!report.violations.length) {
+    root.append(el("p", { className: "clean" }, "No violations."));
+    return;
+  }
+  root.append(violationsSection(report));
+}
+
+function injectStyles(document: Document): void {
+  if (document.getElementById(STYLE_ID)) return;
+  const style = document.createElement("style");
+  style.id = STYLE_ID;
+  style.textContent = styles;
+  document.head.append(style);
+}
+
+function header(report: ValidationReport): HTMLElement {
+  const node = el("header");
+  node.append(el("h1", {}, `Data validation: ${report.table}`));
+  node.append(
+    el(
+      "p",
+      { className: "provenance" },
+      [
+        report.database ? `Database ${report.database}` : "",
+        report.schema_file ? `schema ${report.schema_file}` : "",
+        `generated ${report.generated_at}`,
+      ]
+        .filter(Boolean)
+        .join(" · "),
+    ),
+  );
+  node.append(summary(report));
+  if (report.violations.length || report.violation_count) {
+    node.append(breakdowns(report));
+  }
+  return node;
+}
+
+function summary(report: ValidationReport): HTMLElement {
+  const node = el("div", { className: "summary" });
+  node.append(stat(report.rows_scanned, "rows checked"));
+  if (report.scan_limit !== null) {
+    node.append(stat(report.rows_total, "rows in table"));
+  }
+  node.append(stat(report.violation_count, "violations", report.violation_count > 0));
+  node.append(
+    stat(report.rows_with_violations, "bad rows", report.rows_with_violations > 0),
+  );
+  return node;
+}
+
+function stat(value: number, label: string, bad = false): HTMLElement {
+  const node = el("div", { className: bad ? "stat bad" : "stat" });
+  node.append(el("div", { className: "value" }, formatNumber(value)));
+  node.append(el("div", { className: "label" }, label));
+  return node;
+}
+
+function breakdowns(report: ValidationReport): HTMLElement {
+  const node = el("div", { className: "breakdowns" });
+  node.append(breakdown("By column", report.counts_by_column, "counts-by-column"));
+  node.append(breakdown("By kind", report.counts_by_kind, "counts-by-kind"));
+  return node;
+}
+
+function breakdown(
+  title: string,
+  counts: Record<string, number>,
+  className: string,
+): HTMLElement {
+  const node = el("div", { className: `breakdown ${className}` });
+  node.append(el("h2", {}, title));
+  const list = el("ul");
+  const entries = Object.entries(counts).sort(
+    (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
+  );
+  for (const [name, count] of entries) {
+    const item = el("li");
+    item.append(el("span", { className: "count" }, formatNumber(count)));
+    item.append(document.createTextNode(name));
+    list.append(item);
+  }
+  node.append(list);
+  return node;
+}
+
+function mismatches(report: ValidationReport): HTMLElement {
+  const node = el("div", { className: "mismatches" });
+  node.append(
+    el(
+      "strong",
+      {},
+      "The schema names columns this table does not have, so they were never checked:",
+    ),
+  );
+  const list = el("ul");
+  for (const mismatch of report.mismatches) {
+    list.append(
+      el(
+        "li",
+        {},
+        mismatch.required ? `${mismatch.column} (required)` : mismatch.column,
+      ),
+    );
+  }
+  node.append(list);
+  return node;
+}
+
+function cappedNotice(report: ValidationReport): HTMLElement {
+  return el(
+    "div",
+    { className: "capped" },
+    `Showing ${formatNumber(report.violations_shown)} of ` +
+      `${formatNumber(report.violation_count)} violations. Re-run with a higher ` +
+      `--max-violations to see more.`,
+  );
+}
+
+function violationsSection(report: ValidationReport): HTMLElement {
+  const section = el("section");
+  const state: FilterState = { ...DEFAULT_FILTER_STATE };
+  const body = el("tbody");
+
+  const redraw = (): void => {
+    body.textContent = "";
+    const selected = selectViolations(report.violations, state);
+    if (!selected.length) {
+      const row = el("tr");
+      const cell = el(
+        "td",
+        { className: "empty" },
+        "No violations match these filters.",
+      ) as HTMLTableCellElement;
+      cell.colSpan = 4;
+      row.append(cell);
+      body.append(row);
+      return;
+    }
+    for (const violation of selected) body.append(violationRow(violation, body));
+  };
+
+  section.append(controls(report, state, redraw));
+  const table = el("table");
+  table.append(tableHead());
+  table.append(body);
+  section.append(table);
+  redraw();
+  return section;
+}
+
+function controls(
+  report: ValidationReport,
+  state: FilterState,
+  redraw: () => void,
+): HTMLElement {
+  const node = el("div", { className: "controls" });
+
+  const columns = distinct(report.violations.map((v) => v.column));
+  const kinds = distinct(report.violations.map((v) => v.kind));
+
+  node.append(
+    select("filter-column", [["", "All columns"], ...pairs(columns)], (value) => {
+      state.column = value;
+      redraw();
+    }),
+  );
+  node.append(
+    select("filter-kind", [["", "All kinds"], ...pairs(kinds)], (value) => {
+      state.kind = value;
+      redraw();
+    }),
+  );
+
+  const search = el("input", { className: "search" }) as HTMLInputElement;
+  search.type = "search";
+  search.placeholder = "Search violations";
+  search.addEventListener("input", () => {
+    state.search = search.value;
+    redraw();
+  });
+  node.append(search);
+
+  node.append(
+    select(
+      "sort",
+      [
+        ["row", "Sort by row"],
+        ["column", "Sort by column"],
+        ["kind", "Sort by kind"],
+      ],
+      (value) => {
+        state.sort = value as SortKey;
+        redraw();
+      },
+    ),
+  );
+
+  const direction = el("button", { className: "direction" }, "↑") as HTMLButtonElement;
+  direction.type = "button";
+  direction.title = "Reverse the order";
+  direction.addEventListener("click", () => {
+    state.direction = state.direction === "asc" ? "desc" : "asc";
+    direction.textContent = state.direction === "asc" ? "↑" : "↓";
+    redraw();
+  });
+  node.append(direction);
+
+  return node;
+}
+
+function tableHead(): HTMLElement {
+  const head = el("thead");
+  const row = el("tr");
+  for (const label of ["Row", "Column", "Kind", "Actual value"]) {
+    row.append(el("th", {}, label));
+  }
+  head.append(row);
+  return head;
+}
+
+function violationRow(violation: Violation, body: HTMLElement): HTMLElement {
+  const row = el("tr", { className: "violation" });
+  row.append(el("td", {}, formatKey(violation.key)));
+  row.append(el("td", {}, violation.column));
+  row.append(el("td", { className: "kind" }, violation.kind));
+  row.append(el("td", { className: "value" }, formatValue(violation.actual)));
+  row.addEventListener("click", () => {
+    const existing = row.nextElementSibling;
+    if (existing?.classList.contains("detail")) {
+      existing.remove();
+      return;
+    }
+    body.insertBefore(detailRow(violation), row.nextSibling);
+  });
+  return row;
+}
+
+function detailRow(violation: Violation): HTMLElement {
+  const row = el("tr", { className: "detail" });
+  const cell = el("td") as HTMLTableCellElement;
+  cell.colSpan = 4;
+  const list = el("dl");
+  const entries: [string, string][] = [
+    ["Row", formatKey(violation.key)],
+    ["Column", violation.column],
+    ["Failed", violation.kind],
+    ["Expected", violation.expected],
+    ["Actual", formatValue(violation.actual)],
+    ["Stored as", violation.actual_type],
+  ];
+  if (violation.row) entries.push(["Whole row", formatKey(violation.row)]);
+  for (const [term, description] of entries) {
+    list.append(el("dt", {}, term));
+    list.append(el("dd", {}, description));
+  }
+  cell.append(list);
+  row.append(cell);
+  return row;
+}
+
+function select(
+  className: string,
+  options: readonly (readonly [string, string])[],
+  onChange: (value: string) => void,
+): HTMLSelectElement {
+  const node = el("select", { className }) as HTMLSelectElement;
+  for (const [value, label] of options) {
+    const option = el("option", {}, label) as HTMLOptionElement;
+    option.value = value;
+    node.append(option);
+  }
+  node.addEventListener("change", () => onChange(node.value));
+  return node;
+}
+
+function pairs(values: readonly string[]): [string, string][] {
+  return values.map((value) => [value, value]);
+}
+
+function distinct(values: readonly string[]): string[] {
+  return [...new Set(values)].sort((a, b) => a.localeCompare(b));
+}
+
+function formatNumber(value: number): string {
+  return value.toLocaleString("en-US");
+}
+
+function el(
+  tag: string,
+  properties: { className?: string } = {},
+  text?: string,
+): HTMLElement {
+  const node = document.createElement(tag);
+  if (properties.className) node.className = properties.className;
+  // textContent, never innerHTML - report values come from the data being
+  // validated, which is exactly the data we do not trust
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
