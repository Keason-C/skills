+import json
+import pathlib
+import re
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database, cli
+
+SCHEMA = {
+    "type": "object",
+    "properties": {
+        "id": {"type": "integer"},
+        "name": {"type": "string"},
+        "age": {"type": "integer"},
+    },
+}
+
+
+@pytest.fixture
+def workspace(tmpdir):
+    directory = pathlib.Path(tmpdir)
+    db = Database(str(directory / "data.db"))
+    db.executescript("""
+        create table creatures (id integer primary key, name text, age text);
+        insert into creatures values (1, 'Cleo', '5');
+        insert into creatures values (2, 'Pancakes', 'four');
+        create table clean (id integer primary key, name text, age integer);
+        insert into clean values (1, 'Cleo', 5);
+    """)
+    db.close()
+    (directory / "schema.json").write_text(json.dumps(SCHEMA), "utf-8")
+    return directory
+
+
+def run(workspace, *args):
+    return CliRunner().invoke(
+        cli.cli,
+        ["validate", str(workspace / "data.db"), *args],
+        catch_exceptions=False,
+    )
+
+
+def test_clean_table_exits_zero(workspace):
+    result = run(workspace, "clean", str(workspace / "schema.json"))
+    assert result.exit_code == 0, result.output
+    assert "No violations" in result.output
+
+
+def test_table_with_violations_exits_one(workspace):
+    result = run(workspace, "creatures", str(workspace / "schema.json"))
+    assert result.exit_code == 1
+    assert "age" in result.output
+
+
+@pytest.mark.parametrize(
+    "table,schema,expected",
+    (
+        ("nope", SCHEMA, 'Table "nope" does not exist'),
+        ("creatures", "{not json", "not valid JSON"),
+        ("creatures", {"properties": {"age": {"$ref": "#/x"}}}, '"$ref"'),
+        ("creatures", ["nope"], "must be a JSON object"),
+    ),
+)
+def test_things_that_stop_us_validating_exit_two(workspace, table, schema, expected):
+    path = workspace / "other.json"
+    path.write_text(schema if isinstance(schema, str) else json.dumps(schema), "utf-8")
+    result = run(workspace, table, str(path))
+    assert result.exit_code == 2, result.output
+    assert expected in result.output
+
+
+def test_missing_schema_file_exits_two(workspace):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "validate",
+            str(workspace / "data.db"),
+            "creatures",
+            str(workspace / "nope.json"),
+        ],
+    )
+    assert result.exit_code == 2
+
+
+def test_json_report_is_written_and_has_no_absolute_paths(workspace):
+    out = workspace / "report.json"
+    result = run(
+        workspace, "creatures", str(workspace / "schema.json"), "--json", str(out)
+    )
+    assert result.exit_code == 1
+    report = json.loads(out.read_text("utf-8"))
+    assert report["table"] == "creatures"
+    assert report["database"] == "data.db"
+    assert report["schema_file"] == "schema.json"
+    assert report["ok"] is False
+    assert report["rows_total"] == 2
+    assert report["violation_count"] == 2
+    assert report["counts_by_kind"] == {"type-coercible": 1, "type": 1}
+    assert sorted(v["kind"] for v in report["violations"]) == [
+        "type",
+        "type-coercible",
+    ]
+    assert report["violations"][0]["key"] == {"id": 1}
+    assert report["generated_at"].endswith("Z")
+    assert str(workspace) not in out.read_text("utf-8")
+
+
+def test_coerce_option_accepts_convertible_values(workspace):
+    result = run(workspace, "creatures", str(workspace / "schema.json"), "--coerce")
+    assert result.exit_code == 1
+    assert "1 violation" in result.output
+
+
+def test_limit_option_only_scans_the_head_of_the_table(workspace):
+    out = workspace / "report.json"
+    run(
+        workspace,
+        "creatures",
+        str(workspace / "schema.json"),
+        "--limit",
+        "1",
+        "--json",
+        str(out),
+    )
+    report = json.loads(out.read_text("utf-8"))
+    assert report["rows_scanned"] == 1
+    assert report["rows_total"] == 2
+    assert report["scan_limit"] == 1
+
+
+def test_max_violations_caps_the_detail_without_changing_the_count(workspace):
+    out = workspace / "report.json"
+    run(
+        workspace,
+        "creatures",
+        str(workspace / "schema.json"),
+        "--max-violations",
+        "1",
+        "--json",
+        str(out),
+    )
+    report = json.loads(out.read_text("utf-8"))
+    assert report["violation_count"] == 2
+    assert report["violations_shown"] == 1
+    assert report["truncated"] is True
+
+
+def test_full_rows_option_includes_the_row(workspace):
+    out = workspace / "report.json"
+    run(
+        workspace,
+        "creatures",
+        str(workspace / "schema.json"),
+        "--full-rows",
+        "--json",
+        str(out),
+    )
+    report = json.loads(out.read_text("utf-8"))
+    assert report["violations"][0]["row"] == {"id": 1, "name": "Cleo", "age": "5"}
+
+
+def test_schema_mismatch_is_reported_and_fails(workspace):
+    path = workspace / "typo.json"
+    path.write_text(json.dumps({"properties": {"nmae": {"type": "string"}}}), "utf-8")
+    result = run(workspace, "creatures", str(path))
+    assert result.exit_code == 1
+    assert "nmae" in result.output
+
+
+EXTERNAL_REFERENCE = re.compile(
+    r"""(https?:)?//[^\s'"]+|\b(src|href)\s*=|@import|url\(""", re.IGNORECASE
+)
+
+
+def test_html_report_is_a_single_self_contained_file(workspace):
+    out = workspace / "report.html"
+    result = run(
+        workspace, "creatures", str(workspace / "schema.json"), "--html", str(out)
+    )
+    assert result.exit_code == 1
+    html = out.read_text("utf-8")
+    assert html.startswith("<!DOCTYPE html>")
+    # Nothing to fetch: the operations colleague opening this has no network
+    assert not EXTERNAL_REFERENCE.search(html), EXTERNAL_REFERENCE.search(html).group()
+    assert str(workspace) not in html
+
+
+def test_html_report_shows_the_violations_and_their_provenance(workspace):
+    out = workspace / "report.html"
+    run(workspace, "creatures", str(workspace / "schema.json"), "--html", str(out))
+    html = out.read_text("utf-8")
+    assert "creatures" in html
+    assert "data.db" in html
+    assert "schema.json" in html
+    assert "four" in html
+    assert "type-coercible" in html
+
+
+def test_a_value_containing_a_script_tag_cannot_break_out(workspace):
+    db = Database(str(workspace / "data.db"))
+    db["creatures"].insert(
+        {"id": 3, "name": "</script><script>alert(1)</script>", "age": "1"}
+    )
+    db.close()
+    out = workspace / "report.html"
+    run(
+        workspace,
+        "creatures",
+        str(workspace / "schema.json"),
+        "--full-rows",
+        "--html",
+        str(out),
+    )
+    html = out.read_text("utf-8")
+    assert "</script><script>alert(1)" not in html
+    assert "\\u003c/script>" in html or "\\u003c/script\\u003e" in html
+
+
+def test_json_and_html_can_be_produced_in_the_same_run(workspace):
+    json_out = workspace / "report.json"
+    html_out = workspace / "report.html"
+    run(
+        workspace,
+        "creatures",
+        str(workspace / "schema.json"),
+        "--json",
+        str(json_out),
+        "--html",
+        str(html_out),
+    )
+    assert json.loads(json_out.read_text("utf-8"))["violation_count"] == 2
+    assert html_out.read_text("utf-8").startswith("<!DOCTYPE html>")
+
+
+def test_end_to_end_dirty_data_produces_a_report_naming_the_violations(tmpdir):
+    directory = pathlib.Path(tmpdir)
+    db = Database(str(directory / "loaded.db"))
+    db["imported"].insert_all(
+        [
+            {"id": 1, "email": "a@example.com", "status": "active", "score": "10"},
+            {"id": 2, "email": "not-an-email", "status": "retired", "score": "20"},
+            {"id": 3, "email": "c@example.com", "status": "banana", "score": "-5"},
+        ],
+        pk="id",
+    )
+    db.close()
+    schema = {
+        "type": "object",
+        "properties": {
+            "id": {"type": "integer"},
+            "email": {"type": "string", "pattern": "@"},
+            "status": {"enum": ["active", "retired"]},
+            "score": {"type": "integer", "minimum": 0},
+        },
+    }
+    (directory / "rules.json").write_text(json.dumps(schema), "utf-8")
+    report = directory / "report.html"
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "validate",
+            str(directory / "loaded.db"),
+            "imported",
+            str(directory / "rules.json"),
+            "--html",
+            str(report),
+        ],
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 1
+    html = report.read_text("utf-8")
+    for expected in ("not-an-email", "banana", "pattern", "enum", "type-coercible"):
+        assert expected in html, expected
+    assert not EXTERNAL_REFERENCE.search(html)
+
+
+def test_the_built_report_bundle_ships_with_the_package():
+    # The TypeScript is built into this file and committed, so pytest and
+    # pip install both work with no Node and no network - ADR-0003
+    from sqlite_utils.report import BUNDLE_PATH
+
+    assert BUNDLE_PATH.exists(), f"{BUNDLE_PATH} is missing - run npm run build"
+    assert BUNDLE_PATH.stat().st_size > 1000
+
+
+def test_silent_suppresses_the_summary_but_not_the_exit_code(workspace):
+    result = run(workspace, "creatures", str(workspace / "schema.json"), "--silent")
+    assert result.exit_code == 1
+    assert result.output == ""
+
+
+def test_summary_names_the_violation_kinds_and_columns(workspace):
+    result = run(workspace, "creatures", str(workspace / "schema.json"))
+    assert "2 violations in 2 rows" in result.output
+    assert "By column:" in result.output
+    assert "By kind:" in result.output
+    assert "type-coercible" in result.output
