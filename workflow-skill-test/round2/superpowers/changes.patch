@@ -0,0 +1,62 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ReportData } from "./types";
+
+const data: ReportData = {
+  table: "people",
+  schema_title: "People",
+  generated: "2026-07-31T00:00:00Z",
+  ok: false,
+  rows_checked: 1,
+  total_rows: 1,
+  scan_limited: false,
+  invalid_rows: 1,
+  total_violations: 1,
+  truncated: false,
+  violations_by_column: { age: 1 },
+  violations_by_type: { type: 1 },
+  table_errors: [],
+  violations: [
+    {
+      row_id: { id: 1 },
+      column: "age",
+      error_type: "type",
+      message: "'x' is not of type 'integer'",
+      expected: "integer",
+      actual: "x",
+    },
+  ],
+};
+
+/** Recreate the shell that sqlite_utils/static/validate_report.html provides. */
+function buildShell(payload: string): void {
+  document.body.innerHTML = "";
+  const app = document.createElement("div");
+  app.id = "app";
+  document.body.appendChild(app);
+  const script = document.createElement("script");
+  script.id = "report-data";
+  script.type = "application/json";
+  script.textContent = payload;
+  document.body.appendChild(script);
+}
+
+beforeEach(() => {
+  vi.resetModules();
+  document.body.innerHTML = "";
+});
+
+describe("boot", () => {
+  it("renders the report from the embedded JSON into #app", async () => {
+    buildShell(JSON.stringify(data));
+    await import("./main");
+    const app = document.getElementById("app")!;
+    expect(app.querySelector("h1")!.textContent).toContain("people");
+    expect(app.querySelectorAll("tbody tr.violation")).toHaveLength(1);
+  });
+
+  it("does nothing when the shell elements are missing", async () => {
+    document.body.innerHTML = "<p>nothing here</p>";
+    await expect(import("./main")).resolves.toBeDefined();
+    expect(document.body.textContent).toBe("nothing here");
+  });
+});
diff --git a/frontend/src/main.ts b/frontend/src/main.ts
new file mode 100644
index 0000000..b362805
--- /dev/null
+++ b/frontend/src/main.ts
@@ -0,0 +1,19 @@
+import "./styles.css";
+import { renderReport } from "./render";
+import type { ReportData } from "./types";
+
+function boot(): void {
+  const dataNode = document.getElementById("report-data");
+  const root = document.getElementById("app");
+  if (!dataNode || !root) {
+    return;
+  }
+  const data = JSON.parse(dataNode.textContent || "{}") as ReportData;
+  renderReport(root, data);
+}
+
+if (document.readyState === "loading") {
+  document.addEventListener("DOMContentLoaded", boot);
+} else {
+  boot();
+}
