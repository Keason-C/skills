+class _NoFetchAllCursor:
+    "Wraps a cursor and fails loudly if the row scan tries to buffer every row."
+
+    def __init__(self, cursor):
+        self._cursor = cursor
+
+    def __iter__(self):
+        return iter(self._cursor)
+
+    def fetchall(self):
+        raise AssertionError("rows must be streamed, not loaded with fetchall()")
+
+    def __getattr__(self, name):
+        return getattr(self._cursor, name)
+
+
+def test_rows_are_streamed_rather_than_buffered(db, monkeypatch):
+    db["people"].insert_all(
+        [{"id": i, "name": "n", "age": "bad"} for i in range(1, 21)],
+        pk="id",
+        columns={"age": str},
+    )
+    table = db["people"]
+    real_execute = table.db.execute
+
+    def guarded_execute(sql, *args, **kwargs):
+        cursor = real_execute(sql, *args, **kwargs)
+        # Only the full row scan has to stream; introspection queries are tiny
+        if sql.lower().startswith("select") and "people" in sql:
+            return _NoFetchAllCursor(cursor)
+        return cursor
+
+    monkeypatch.setattr(table.db, "execute", guarded_execute)
+    result = validate_table(table, PERSON_SCHEMA)
+    assert result.rows_checked == 20
+    assert result.total_violations == 20
+
+
+def test_validates_table_whose_name_needs_quoting(db):
