{
  "additionalProperties": false,
  "description": "One inbound customer-support request, as received. Immutable once accepted.",
  "properties": {
    "amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount"
    },
    "body": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "customer_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Customer Id",
      "type": "string"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "order_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order Id"
    },
    "subject": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "id",
    "customer_id",
    "subject",
    "body"
  ],
  "title": "Ticket",
  "type": "object"
}
